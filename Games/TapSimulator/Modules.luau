}
end

Modules["features/stars"] = function(use)
-- Rewards tab: the 15 Shiny Stars hidden on the islands (Shared.Game.ShinyStarConfig). Finding all
-- of them doubles the Shiny mutation chance on every hatch, 2% -> 4%, for good.
--
-- The stars only exist on the client once streamed in (within ~200 studs), so where they stand is
-- kept here, measured in the game. ShinyStarService.Collect(id) picks one up when you are within
-- ServerReach (22 studs) of it; Data.ShinyStars.Found says which you have.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local RunService = game:GetService("RunService")
local tab = Ui.Tabs.Rewards

local Config
do
    local ok, module = Env.call(function()
        return require(Env.ReplicatedStorage.Shared.Game.ShinyStarConfig)
    end)
    Config = ok and type(module) == "table" and module or nil
end

local POSITIONS = {
    Spawn1 = Vector3.new(53.6, -512.3, -2015.7),
    Spawn2 = Vector3.new(-4.4, -512.3, -1699.5),
    Spawn3 = Vector3.new(-98.3, -386.5, -1534.2),
    SkyIsland1 = Vector3.new(-79.7, -47.9, -1930.4),
    SkyIsland2 = Vector3.new(-61.9, -52.6, -1791.1),
    Autumn1 = Vector3.new(-125.5, 906.1, -1978.3),
    Autumn2 = Vector3.new(23.6, 884.0, -1947.9),
    Mushroom1 = Vector3.new(78.9, 2035.8, -1996.0),
    Mushroom2 = Vector3.new(-124.1, 2033.5, -2067.9),
    Desert1 = Vector3.new(13.2, 3644.1, -2165.9),
    Desert2 = Vector3.new(59.1, 3637.2, -1979.1),
    CrystalCave1 = Vector3.new(-235.0, 5445.9, -2050.9),
    CrystalCave2 = Vector3.new(19.7, 5447.8, -2033.5),
    ShadowRelm1 = Vector3.new(13.2, 7693.0, -2106.3),
    ShadowRelm2 = Vector3.new(197.8, 7699.1, -1858.6),
}

local function starList()
    local list = {}
    for _, star in ipairs(Config and Config.Stars or {}) do
        list[#list + 1] = star
    end
    if #list == 0 then
        for id in pairs(POSITIONS) do
            list[#list + 1] = { Id = id }
        end
        table.sort(list, function(a, b)
            return a.Id < b.Id
        end)
    end
    return list
end

local function found(data, id)
    local stars = data and type(data.ShinyStars) == "table" and data.ShinyStars
    return type(stars) == "table" and type(stars.Found) == "table" and stars.Found[id] == true
end

local function unlocked(data)
    local stars = data and type(data.ShinyStars) == "table" and data.ShinyStars
    return type(stars) == "table" and stars.Unlocked == true
end

-- Where the star stands: the streamed-in star itself if it is here, else the measured spot.
local function positionOf(id)
    local folder = workspace:FindFirstChild(Config and Config.Folder or "ShinyStars")
    for _, part in ipairs(folder and folder:GetDescendants() or {}) do
        if part:GetAttribute("ShinyStarId") == id then
            local ok, position = pcall(function()
                return part:IsA("Model") and part:GetPivot().Position or part.Position
            end)
            if ok then
                return position
            end
        end
    end
    return POSITIONS[id]
end

local box = tab:AddGroupbox({ Side = "Right", Name = "Shiny Stars", IconName = "star" })
local label = box:AddLabel("Checking...", true)

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local busy = false
local function collectAll()
    if busy or Ui.hatchMoving or Ui.travelling then
        Ui.notify("Tap Simulator", Ui.travelling == "mining" and "Auto mine is using your character; turn it off first."
            or "Busy with another trip; try again in a moment.", 5)
        return
    end
    busy = true
    Ui.travelling = "stars"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local picked, failed = 0, {}
    local ok, err = pcall(function()
        for _, star in ipairs(starList()) do
            if not Life.alive then
                break
            end
            if not found(Env.data(), star.Id) then
                local spot = positionOf(star.Id)
                local here = root()
                if spot and here then
                    Env.streamAround(spot, 6)
                    -- Some stars float in mid-air: you are held on the spot (every frame) until the
                    -- star is yours, or a fall carries you out of the server's reach first.
                    local target = CFrame.new(spot + Vector3.new(0, 3, 0))
                    local hold = RunService.Heartbeat:Connect(function()
                        local current = root()
                        if current then
                            current.AssemblyLinearVelocity = Vector3.zero
                            current.CFrame = target
                        end
                    end)
                    local okHold = pcall(function()
                        Life.wait(0.5) -- the server has to see you there before it hands the star over
                        -- Standing on it, the game's own pickup may get there first; either is fine.
                        local deadline = os.clock() + 1.5
                        while Life.alive and not found(Env.data(), star.Id) and os.clock() < deadline do
                            Life.wait(0.2)
                        end
                        for _ = 1, 2 do
                            if found(Env.data(), star.Id) then
                                break
                            end
                            Env.invoke("ShinyStarService", "Collect", star.Id)
                            Life.wait(0.6)
                        end
                    end)
                    hold:Disconnect()
                    Env.elevate()
                    if not okHold then
                        failed[#failed + 1] = star.Id
                    elseif found(Env.data(), star.Id) then
                        picked += 1
                    else
                        failed[#failed + 1] = star.Id
                    end
                end
            end
        end
    end)
    Env.elevate()
    if not ok then
        Life.errors["stars:collect"] = tostring(err)
    end
    if home then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    Ui.travelling = false
    busy = false
    local data = Env.data()
    Ui.notify("Tap Simulator", (#failed == 0 and string.format("Collected %d Shiny Stars.", picked)
        or string.format("Collected %d; could not get %s.", picked, table.concat(failed, ", ")))
        .. (unlocked(data) and " Shiny mutation chance is now 4%." or ""), 8)
end

box:AddButton({
    Text = "Collect Shiny Stars",
    Func = function()
        Life.spawn("stars:collect", collectAll)
    end,
    Tooltip = "Goes to each Shiny Star you have not found, picks it up and brings you back. All 15 double the Shiny mutation chance on every hatch (2% to 4%).",
})

Life.loop("stars:panel", 2, function()
    local data = Env.data()
    if not data then
        return
    end
    local count, total = 0, 0
    for _, star in ipairs(starList()) do
        total += 1
        if found(data, star.Id) then
            count += 1
        end
    end
    label:SetText(unlocked(data) and string.format("All %d found: Shiny mutation chance is 4%%.", total)
        or string.format("%d / %d found. All of them double the Shiny mutation chance (2%% to 4%%).", count, total))
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
end)

return {
    collect = function()
        Life.spawn("stars:collect", collectAll)
    end,
}
end

Modules["features/items"] = function(use)
-- Rewards tab: items that do something when used, and rewards waiting to be claimed.
--
--   Totems (Shared.Items.TotemConfig): ItemService.PlaceTotem { TotemName, Position } drops one
--     where you stand; it boosts everyone within its Range (12-28 studs) for 5-17 minutes. Placed
--     only while you are standing at your hatch spot, and never on top of a running one of its kind
--     (ItemService.GetActiveTotems).
--   Gifts (Shared.Items.GiftConfig): GiftService.OpenGift { Gift, Amount }.
--   Weather dials: WeatherDialService.CanUse(kind) then Use(kind), "Rain" for the Rain Dial and
--     "Acid" for the Acid Dial, as the item's own use does.
--   Mastery rings (Shared.Progression.RelicConfig): earned at mastery level 100; MasteryService
--     .EquipRelic { Name } wears one.
--   Leaderboards: LeaderboardService.GetPendingRewards, then ClaimReward(LeaderboardId) each.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local Options = Ui.Options
local tab = Ui.Tabs.Rewards
local RS = Env.ReplicatedStorage

local function load(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = RS
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local TotemConfig = load("Shared", "Items", "TotemConfig")
local GiftConfig = load("Shared", "Items", "GiftConfig")
local RelicConfig = load("Shared", "Progression", "RelicConfig")

local TOTEMS = {}
for name in pairs(TotemConfig or {}) do
    if type(name) == "string" then
        TOTEMS[#TOTEMS + 1] = name
    end
end
table.sort(TOTEMS)

-- Gift items are the GiftConfig entries that hold a list of prizes.
local GIFTS = {}
for name, entry in pairs(GiftConfig or {}) do
    if type(name) == "string" and type(entry) == "table" and type(entry[1]) == "table" then
        GIFTS[#GIFTS + 1] = name
    end
end
table.sort(GIFTS)

local DIALS = { RainDial = "Rain", AcidDial = "Acid" }
local RINGS = RelicConfig and RelicConfig.Order or { "HatchRing", "SecretRing", "TapRing", "GoldenRing", "EnchantRing" }

local box = tab:AddGroupbox({ Side = "Right", Name = "Items and rewards", IconName = "package" })
box:AddToggle("AutoTotems", {
    Text = "Place totems",
    Default = false,
    Tooltip = "Places the totems you own where you hatch (they boost everything within 12-28 studs for 5-17 minutes), one of each kind at a time.",
})
Ui.automation("AutoTotems", true)
box:AddDropdown("TotemPicks", {
    Text = "Totems",
    Values = #TOTEMS > 0 and TOTEMS or { "TotemOfLuck" },
    Multi = true,
    Default = TOTEMS,
})
box:AddToggle("AutoGifts", {
    Text = "Open gifts",
    Default = false,
    Tooltip = "Opens every gift item you get (Octo Incubators, rare pets and more inside).",
})
Ui.automation("AutoGifts", true)
box:AddToggle("AutoDials", {
    Text = "Use weather dials",
    Default = false,
    Tooltip = "Uses Rain Dials and Acid Dials (from Pet Defense) as soon as the game lets you.",
})
Ui.automation("AutoDials", true)
box:AddToggle("AutoRing", {
    Text = "Wear a mastery ring",
    Default = true,
    Tooltip = "Mastery rings are earned at mastery level 100. When you have one and wear none, the first in the list you own goes on.",
})
Ui.automation("AutoRing", true)
box:AddDropdown("RingOrder", {
    Text = "Preferred ring",
    Values = RINGS,
    Default = RINGS[1],
})
box:AddToggle("AutoLeaderboard", {
    Text = "Claim leaderboard rewards",
    Default = true,
    Tooltip = "Claims the weekly leaderboard rewards as soon as you have any.",
})
Ui.automation("AutoLeaderboard", true)
local label = box:AddLabel("", true)

local session = { totems = 0, gifts = 0, dials = 0, rings = 0, boards = 0, note = "" }

local function owned(data, name)
    local items = type(data.Items) == "table" and type(data.Items.Owned) == "table" and data.Items.Owned or {}
    return tonumber(items[name]) or 0
end

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- Totems --------------------------------------------------------------------------------------

local function activeTotems()
    local ok, result = Env.invoke("ItemService", "GetActiveTotems")
    local kinds = {}
    for _, entry in pairs(ok and type(result) == "table" and result or {}) do
        local name = type(entry) == "table" and (entry.TotemName or entry.Name or entry.Totem) or entry
        if type(name) == "string" then
            kinds[name] = true
        end
    end
    return kinds
end

local function placeTotems(data)
    -- Only where the boost matters: standing still at the egg, not mid-trip.
    if Ui.travelling or Ui.hatchMoving or not Ui.on("AutoHatch") then
        return
    end
    local picks = Options.TotemPicks.Value or {}
    local active
    for _, name in ipairs(TOTEMS) do
        if picks[name] and owned(data, name) > 0 then
            active = active or activeTotems()
            if not active[name] then
                local hrp = root()
                if not hrp then
                    return
                end
                local ok, result = Env.invoke("ItemService", "PlaceTotem", { TotemName = name, Position = hrp.Position })
                if ok and type(result) == "table" and result.Success == true then
                    session.totems += 1
                    session.note = "Placed a " .. name .. "."
                    active[name] = true
                else
                    session.note = string.format("%s: %s.", name, tostring(type(result) == "table" and (result.Reason or result.Error) or result))
                end
                Life.wait(0.5)
            end
        end
    end
end

-- Gifts and dials -------------------------------------------------------------------------------

local function openGifts(data)
    for _, gift in ipairs(GIFTS) do
        local count = owned(data, gift)
        if count > 0 then
            local ok, result = Env.invoke("GiftService", "OpenGift", { Gift = gift, Amount = count })
            if ok and type(result) == "table" and result.Success ~= false and not result.Error then
                session.gifts += count
                session.note = string.format("Opened %d %s.", count, gift)
            else
                session.note = string.format("%s: %s.", gift, tostring(type(result) == "table" and (result.Reason or result.Error) or result))
            end
            Life.wait(0.6)
        end
    end
end

local dialWait = {}
local function useDials(data)
    for item, kind in pairs(DIALS) do
        if owned(data, item) > 0 and (dialWait[kind] or 0) <= os.clock() then
            local ok, check = Env.invoke("WeatherDialService", "CanUse", kind)
            if ok and type(check) == "table" and check.Success == true then
                local used, result = Env.invoke("WeatherDialService", "Use", kind)
                if used and type(result) == "table" and result.Success == true then
                    session.dials += 1
                    session.note = "Used a " .. item .. "."
                else
                    dialWait[kind] = os.clock() + 60
                end
            else
                -- another weather is running, or the game says not yet
                dialWait[kind] = os.clock() + 60
            end
            Life.wait(0.5)
        end
    end
end

-- Mastery ring and leaderboards ---------------------------------------------------------------

local function wearRing(data)
    local mastery = type(data.Mastery) == "table" and data.Mastery or {}
    if type(mastery.EquippedRelic) == "string" or type(mastery.RelicInventory) ~= "table" then
        return
    end
    local order = { Options.RingOrder.Value }
    for _, ring in ipairs(RINGS) do
        order[#order + 1] = ring
    end
    for _, ring in ipairs(order) do
        if mastery.RelicInventory[ring] == true then
            local ok, result = Env.invoke("MasteryService", "EquipRelic", { Name = ring })
            if ok and type(result) == "table" and result.Success == true then
                session.rings += 1
                session.note = "Wearing the " .. ring .. "."
            end
            return
        end
    end
end

local nextBoards = 0
local function claimBoards()
    if os.clock() < nextBoards then
        return
    end
    nextBoards = os.clock() + 300
    local ok, pending = Env.invoke("LeaderboardService", "GetPendingRewards")
    for _, entry in pairs(ok and type(pending) == "table" and pending or {}) do
        if type(entry) == "table" and entry.LeaderboardId ~= nil then
            local claimed, result = Env.invoke("LeaderboardService", "ClaimReward", entry.LeaderboardId)
            if claimed and type(result) == "table" and result.Success ~= false then
                session.boards += 1
                session.note = "Claimed a leaderboard reward."
            elseif type(result) == "table" and result.Reason == "StorageFull" then
                session.note = "Leaderboard reward waiting: your pet storage is full."
            end
            Life.wait(0.5)
        end
    end
end

Life.loop("items:auto", 3, function()
    local data = Env.data()
    if not data then
        return
    end
    if Ui.on("AutoGifts") then
        openGifts(data)
    end
    if Ui.on("AutoDials") then
        useDials(data)
    end
    if Ui.on("AutoRing") then
        wearRing(data)
    end
    if Ui.on("AutoLeaderboard") then
        claimBoards()
    end
    if Ui.on("AutoTotems") then
        placeTotems(data)
    end
    local counts = {}
    for _, name in ipairs(TOTEMS) do
        local n = owned(data, name)
        if n > 0 then
            counts[#counts + 1] = string.format("%d %s", n, (name:gsub("^TotemOf", "")))
        end
    end
    local lines = {
        "Totems owned: " .. (#counts > 0 and table.concat(counts, ", ") or "none"),
        string.format("This session: %d totems, %d gifts, %d dials, %d leaderboard rewards.", session.totems, session.gifts,
            session.dials, session.boards),
    }
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    label:SetText(table.concat(lines, "\n"))
end)

return {}
end

Modules["features/pickups"] = function(use)
-- Rewards tab: the things that show up on screen to be clicked. The Lucky Ducky flying across the
-- screen, and the Balloon Party and "Pigs could fly" world events.
--
-- Lucky Ducky (LuckyDuckyService): once you have an hour of playtime, the server sends Spawn { Id,
-- Lifetime, Why } every 20-30 minutes and the duck crosses the screen for ~10 seconds. Claim(Id)
-- rolls x2 coins for 2 min (60%), a pile of coins (27%), x3 coins for 2 min (10%) or 1 in 4
-- hatches Golden for 1 min (3%). The server refuses a claim sooner than 0.3s after the spawn, so
-- the catch waits a human moment, then goes through the game's own LuckyDuckyController:CatchShown
-- (its animation, claim and reward banner); Claim(Id) is sent directly only if no duck was drawn.
--
-- Balloon Party (BalloonPartyService), every 45 minutes for 2 minutes: balloons launch around each
-- player (Launched { Uid, Origin, Rise, Phase, LaunchedAt, Size }) and rise on a path anyone can
-- compute (Shared.Admin.BalloonFlight). Hit(Uid) counts a tap from up to HitRange (150) studs, once
-- per HitCooldown per balloon; Size sets how many taps it takes. The server confirms each tap on
-- Hit (Uid, Taken, UserId), and Popped / Rewarded follow.
--
-- Pigs could fly (PigsCouldFlyService): pigs circle each player on PigFlight paths; one Hit(Uid)
-- from within 120 studs catches one, Caught (Uid, UserId) and Rewarded follow, Retired ends one.
--
-- Both events spawn around you, so nothing here moves the character: it taps what is in range.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local RunService = game:GetService("RunService")
local tab = Ui.Tabs.World
local RS = Env.ReplicatedStorage

local function load(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = RS
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local DuckController = load("Controllers", "Game", "LuckyDuckyController")
local WorldEventConfig = load("Shared", "Admin", "WorldEventConfig")
local BalloonFlight = load("Shared", "Admin", "BalloonFlight")
local PigFlight = load("Shared", "Admin", "PigFlight")
local BalloonRules = WorldEventConfig and WorldEventConfig.Balloon or {}
local PigRules = WorldEventConfig and WorldEventConfig.Pig or {}

-- Inside the game's own ranges, so a tap is never judged out of reach on the server's clock.
local BALLOON_RANGE = (tonumber(BalloonRules.HitRange) or 150) - 15
local BALLOON_GAP = (tonumber(BalloonRules.HitCooldown) or 0.1) + 0.06
local PIG_RANGE = (tonumber(PigRules.HitRange) or 120) - 15
local PIG_GAP = 0.6
local TAP_GAP = 0.09 -- between any two taps, about as fast as a quick thumb

local box = tab:AddGroupbox({ Side = "Left", Name = "Pickups", IconName = "sparkles" })
box:AddToggle("AutoDuck", {
    Text = "Catch the Lucky Ducky",
    Default = true,
    Tooltip = "Catches the duck that flies across your screen every 20-30 minutes (after an hour of playtime): x2 or x3 coins for 2 minutes, a pile of coins, or Golden hatches for a minute.",
})
Ui.automation("AutoDuck", true)
box:AddToggle("AutoBalloons", {
    Text = "Pop Balloon Party balloons",
    Default = true,
    Tooltip = "During the Balloon Party event (every 45 minutes, 2 minutes long), taps every balloon within reach until it pops. Balloons give coins and gems.",
})
Ui.automation("AutoBalloons", true)
box:AddToggle("AutoPigs", {
    Text = "Catch flying pigs",
    Default = true,
    Tooltip = "During the \"Pigs could fly\" event, catches every pig within reach for coins and gems.",
})
Ui.automation("AutoPigs", true)
local label = box:AddLabel("Waiting for a duck, balloons or pigs.", true)

local session = { ducks = 0, duckNote = nil, balloons = 0, pigs = 0, coins = 0, gems = 0 }

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function short(n)
    for _, unit in ipairs({ { 1e18, "Qi" }, { 1e15, "Q" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= unit[1] then
            return string.format("%.1f%s", n / unit[1], unit[2])
        end
    end
    return tostring(math.floor(n))
end

local function addReward(reward)
    if type(reward) ~= "table" then
        return
    end
    session.coins += tonumber(reward.Coins) or 0
    session.gems += tonumber(reward.Gems) or 0
end

-- Lucky Ducky ----------------------------------------------------------------------------------

local function catchDuck(payload)
    Life.wait(0.7 + math.random() * 0.8)
    if not Ui.on("AutoDuck") then
        return
    end
    local caught = false
    if DuckController and type(DuckController.CatchShown) == "function" then
        local ok, result = Env.call(DuckController.CatchShown, DuckController)
        caught = ok and result == true
    end
    if caught then
        session.ducks += 1
        session.duckNote = "caught"
        return
    end
    local ok, result = Env.invoke("LuckyDuckyService", "Claim", payload.Id)
    if ok and type(result) == "table" and result.Success == true then
        session.ducks += 1
        session.duckNote = tostring(result.Title or result.Reward or "caught")
        if type(result.Coins) == "number" then
            session.coins += result.Coins
        end
    else
        session.duckNote = "got away: " .. tostring(type(result) == "table" and result.Reason or result)
    end
end

Life.spawn("pickups:duck", function()
    local remote = Env.remote("LuckyDuckyService", "Spawn")
    Life.connect(remote.OnClientEvent, function(payload)
        if Ui.on("AutoDuck") and type(payload) == "table" and payload.Id ~= nil then
            Life.spawn("pickups:duck-catch", catchDuck, payload)
        end
    end)
end)

-- Balloons and pigs ----------------------------------------------------------------------------

local balloons = {} -- uid -> { flight, needed, taken, last }
local pigs = {} -- uid -> { flight, last }
-- uids this hub tapped: Rewarded is only counted for those, whoever else it may reach.
local tappedByMe = {}

local function trackBalloon(flight)
    if type(flight) ~= "table" or type(flight.Uid) ~= "string" or balloons[flight.Uid] then
        return
    end
    if typeof(flight.Origin) ~= "Vector3" or type(flight.Rise) ~= "number" or type(flight.LaunchedAt) ~= "number" then
        return
    end
    local size = type(BalloonRules.Sizes) == "table" and BalloonRules.Sizes[flight.Size]
    balloons[flight.Uid] = {
        flight = flight,
        needed = size and tonumber(size.Hits) or 1,
        taken = 0,
        last = 0,
    }
end

local function trackPig(flight)
    if type(flight) ~= "table" or type(flight.Uid) ~= "string" or pigs[flight.Uid] then
        return
    end
    if typeof(flight.Centre) ~= "Vector3" or typeof(flight.Pass) ~= "Vector3" or type(flight.LaunchedAt) ~= "number" then
        return
    end
    pigs[flight.Uid] = { flight = flight, last = 0 }
end

Life.spawn("pickups:balloon-events", function()
    Life.connect(Env.remote("BalloonPartyService", "Launched").OnClientEvent, trackBalloon)
    Life.connect(Env.remote("BalloonPartyService", "Hit").OnClientEvent, function(uid, taken)
        local balloon = type(uid) == "string" and balloons[uid]
        if balloon and type(taken) == "number" then
            balloon.taken = math.max(balloon.taken, taken)
        end
    end)
    Life.connect(Env.remote("BalloonPartyService", "Popped").OnClientEvent, function(uid)
        if type(uid) == "string" then
            balloons[uid] = nil
        end
    end)
    Life.connect(Env.remote("BalloonPartyService", "Rewarded").OnClientEvent, function(uid, reward)
        if tappedByMe[uid] then
            tappedByMe[uid] = nil
            session.balloons += 1
            addReward(reward)
        end
    end)
    -- A party already running when the hub loads.
    local ok, active = Env.invoke("BalloonPartyService", "GetActive")
    for _, flight in ipairs(ok and type(active) == "table" and active or {}) do
        trackBalloon(flight)
    end
end)

Life.spawn("pickups:pig-events", function()
    Life.connect(Env.remote("PigsCouldFlyService", "Launched").OnClientEvent, trackPig)
    local function gone(uid)
        if type(uid) == "string" then
            pigs[uid] = nil
        end
    end
    Life.connect(Env.remote("PigsCouldFlyService", "Caught").OnClientEvent, gone)
    Life.connect(Env.remote("PigsCouldFlyService", "Retired").OnClientEvent, gone)
    Life.connect(Env.remote("PigsCouldFlyService", "Rewarded").OnClientEvent, function(uid, reward)
        if tappedByMe[uid] then
            tappedByMe[uid] = nil
            session.pigs += 1
            addReward(reward)
        end
    end)
    local ok, active = Env.invoke("PigsCouldFlyService", "GetActive")
    for _, flight in ipairs(ok and type(active) == "table" and active or {}) do
        trackPig(flight)
    end
end)

-- Where a balloon is now, or nil once it has flown off.
local function balloonAt(balloon, now)
    local age = now - balloon.flight.LaunchedAt
    if not BalloonFlight or age >= (BalloonFlight.Lifetime or 25) then
        return nil
    end
    local ok, position = pcall(BalloonFlight.Position, balloon.flight, age)
    return ok and typeof(position) == "Vector3" and position or nil
end

local function pigAt(pig, now)
    local age = now - pig.flight.LaunchedAt
    if not PigFlight or age >= (PigFlight.Lifetime or 40) then
        return nil
    end
    local ok, position = pcall(PigFlight.Position, pig.flight, age)
    return ok and typeof(position) == "Vector3" and position or nil
end

-- The next tap: a pig first (one tap catches it), then the balloon closest to popping, so a
-- tap is never spread thin across a sky full of half-hit balloons.
local function nextTap(here, now, clock)
    if Ui.on("AutoPigs") then
        for uid, pig in pairs(pigs) do
            local at = pigAt(pig, now)
            if not at then
                pigs[uid] = nil
            elseif clock - pig.last >= PIG_GAP and (at - here).Magnitude <= PIG_RANGE then
                return "PigsCouldFlyService", uid, pig
            end
        end
    end
    if Ui.on("AutoBalloons") then
        local best, bestUid, bestLeft
        for uid, balloon in pairs(balloons) do
            local at = balloonAt(balloon, now)
            if not at then
                balloons[uid] = nil
            elseif clock - balloon.last >= BALLOON_GAP and (at - here).Magnitude <= BALLOON_RANGE then
                local left = balloon.needed - balloon.taken
                if left > 0 and (not best or left < bestLeft) then
                    best, bestUid, bestLeft = balloon, uid, left
                end
            end
        end
        if best then
            return "BalloonPartyService", bestUid, best
        end
    end
    return nil
end

Life.spawn("pickups:tap", function()
    while Life.alive do
        local hrp = root()
        local tapped = false
        if hrp and (next(balloons) or next(pigs)) then
            local clock = os.clock()
            local service, uid, target = nextTap(hrp.Position, workspace:GetServerTimeNow(), clock)
            if service then
                target.last = clock
                tappedByMe[uid] = true
                Env.fire(service, "Hit", uid)
                tapped = true
            end
        end
        if tapped then
            Life.wait(TAP_GAP)
        else
            Life.wait(0.15)
        end
    end
end)

Life.loop("pickups:panel", 1, function()
    local live = 0
    for _ in pairs(balloons) do
        live += 1
    end
    local pigsLive = 0
    for _ in pairs(pigs) do
        pigsLive += 1
    end
    local lines = {
        string.format("Ducks caught: %d%s", session.ducks, session.duckNote and (" (last " .. session.duckNote .. ")") or ""),
        string.format("Balloons popped: %d, pigs caught: %d", session.balloons, session.pigs),
    }
    if session.coins > 0 or session.gems > 0 then
        lines[#lines + 1] = string.format("From them: %s coins, %s gems", short(session.coins), short(session.gems))
    end
    if live > 0 or pigsLive > 0 then
        lines[#lines + 1] = string.format("In the sky now: %d balloons, %d pigs", live, pigsLive)
    end
    label:SetText(table.concat(lines, "\n"))
end)

return {}
end

Modules["features/dig"] = function(use)
-- Rewards tab: the Autumn island dig site. Ten digs an hour, each a timing game: a cursor sweeps a
-- bar and a hit inside the highlighted zone takes one layer off the buried treat (RegularTreat or
-- BagOfTreats); a miss puts two back.
--
-- DigService.Begin() starts a dig (or resumes the treat already buried for you) and answers with
-- the round: Epoch, Phase, Speed, Center, Width and a Sequence. Hit(Id, Sequence, time) is judged
-- at that server time with the game's own DigConfig.Cursor, so the hit is timed for the moment the
-- cursor crosses the middle of the zone, never sooner than MinHitInterval after the last one. The
-- server only accepts hits from someone standing on the dig site (DigWorld.Contains), so a dig is
-- a trip like a craft: auto hatch pauses, the dig runs, and you go back where you were.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local RunService = game:GetService("RunService")
local tab = Ui.Tabs.World

local DigConfig, DigWorld
do
    local ok, config = Env.call(function()
        return require(Env.ReplicatedStorage.Shared.Minigames.DigConfig)
    end)
    DigConfig = ok and type(config) == "table" and config or nil
    local ok2, world = Env.call(function()
        return require(Env.ReplicatedStorage.Shared.Minigames.DigWorld)
    end)
    DigWorld = ok2 and type(world) == "table" and world or nil
end

-- The dig site is Persistent for streaming once loaded, but a fresh server may not have sent it.
local SITE_FALLBACK = Vector3.new(-82, 873, -1623)
-- How close to the zone's middle a hit aims, as a share of its width; the zone shrinks as the
-- cursor speeds up, so the middle leaves room for the request's travel time.
local AIM = { 0.25, 0.6, 1 }

local box = tab:AddGroupbox({ Side = "Left", Name = "Dig site", IconName = "shovel" })
box:AddToggle("AutoDig", {
    Text = "Auto dig",
    Default = false,
    Tooltip = "Goes to the Autumn dig site whenever a dig is free (10 an hour), plays it without missing, and comes back. Each dig gives a Treat or a Bag of Treats.",
})
Ui.automation("AutoDig", false)
box:AddToggle("DigReturn", {
    Text = "Return to where I was",
    Default = true,
})
local label = box:AddLabel("Auto dig is off.", true)

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function digging(data)
    return data and type(data.Digging) == "table" and data.Digging or nil
end

-- Digs left this hour and seconds until the hour resets.
local function allowance(data)
    local state = digging(data)
    if not (state and DigConfig) then
        return 0, 0
    end
    local ok, left, wait = Env.call(DigConfig.Allowance, state, os.time())
    if ok and type(left) == "number" then
        return left, tonumber(wait) or 0
    end
    return 0, 0
end

local function digZone()
    local site = DigWorld and DigWorld.GetSite()
    return site and site:FindFirstChild("DigZone")
end

local function standOnSite()
    local hrp = root()
    if not hrp then
        return false
    end
    local zone = digZone()
    if not zone then
        Env.streamAround(SITE_FALLBACK, 10)
        hrp.CFrame = CFrame.new(SITE_FALLBACK + Vector3.new(0, 4, 0))
        local deadline = os.clock() + 8
        while Life.alive and not zone and os.clock() < deadline do
            Life.wait(0.2)
            zone = digZone()
        end
    end
    if not zone then
        return false
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = zone.CFrame * CFrame.new(0, 3, 0)
    local deadline = os.clock() + 3
    while Life.alive and os.clock() < deadline do
        Life.wait(0.15)
        local character = Env.LocalPlayer.Character
        if character and DigWorld.Contains(zone, character) then
            Life.wait(0.3) -- let the server see us there too
            return true
        end
    end
    return false
end

-- The first server time after `from` at which the cursor is within `share` of the zone's middle.
local function aimAt(round, from)
    for _, share in ipairs(AIM) do
        local half = round.Width * share / 2
        for t = from, from + 8, 0.004 do
            if math.abs(DigConfig.Cursor(round, t) - round.Center) <= half then
                return t
            end
        end
    end
    return nil
end

local session = { digs = 0, hits = 0, misses = 0, treats = {} }
local note = ""

-- Plays one dig to the end. Returns the reward name, or nil and why not. A dig that stops early is
-- cancelled, as the game's Stop button does; the treat stays buried for the next one.
local function playDig()
    local ok, state = Env.invoke("DigService", "Begin")
    if not ok or type(state) ~= "table" then
        return nil, "the dig did not start"
    end
    local id = state.Id
    local function stop(why)
        if id then
            Env.invoke("DigService", "Cancel", id)
        end
        return nil, why
    end
    local lastHit = workspace:GetServerTimeNow()
    for _ = 1, 60 do
        if not Life.alive then
            return stop("unloaded")
        end
        if state.Complete then
            return tostring(state.Reward or "a treat")
        end
        if state.Error then
            return stop(tostring(state.Error))
        end
        local round = state.Round
        if type(round) ~= "table" or not state.Id then
            return stop("unexpected answer from the dig site")
        end
        id = state.Id
        local from = math.max(workspace:GetServerTimeNow() + 0.06, round.Epoch + 0.02,
            lastHit + DigConfig.MinHitInterval + 0.02)
        local target = aimAt(round, from)
        if not target then
            return stop("no hit window found")
        end
        while workspace:GetServerTimeNow() < target do
            RunService.Heartbeat:Wait()
        end
        local at = workspace:GetServerTimeNow()
        if DigConfig.IsHit(round, at) then
            session.hits += 1
        else
            session.misses += 1
        end
        lastHit = at
        local ok2, answer = Env.invoke("DigService", "Hit", id, round.Sequence, at)
        if not ok2 or type(answer) ~= "table" then
            return stop("a hit got no answer")
        end
        if answer.Error == "TooSoon" or answer.Error == "Busy" then
            Life.wait(0.2) -- same round again
        else
            state = answer
        end
    end
    return stop("the dig never finished")
end

local busy = false
local function digTrip()
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "dig"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(function()
        Ui.status = "Digging"
        if not standOnSite() then
            note = "Could not reach the dig site."
            return
        end
        while Life.alive and Ui.on("AutoDig") and allowance(Env.data()) > 0 do
            local reward, why = playDig()
            if not reward then
                note = "Last dig stopped: " .. tostring(why) .. "."
                break
            end
            session.digs += 1
            session.treats[reward] = (session.treats[reward] or 0) + 1
            note = "Last dig: " .. reward .. "."
            Life.wait(0.6)
        end
    end)
    Env.elevate()
    if not ok then
        Life.errors["dig:trip"] = tostring(err)
        note = "Dig error: " .. tostring(err)
    end
    if home and Ui.on("DigReturn") then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    if Ui.status == "Digging" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

local nextTry = 0
Life.loop("dig:auto", 1, function()
    local data = Env.data()
    local left, wait = allowance(data)
    local pending = digging(data) and digging(data).PendingReward
    local parts = {}
    for name, count in pairs(session.treats) do
        parts[#parts + 1] = string.format("%d %s", count, name)
    end
    table.sort(parts)
    local status = left > 0 and string.format("%d digs free now", left)
        or string.format("next digs in %dm %02ds", math.floor(wait / 60), math.floor(wait % 60))
    local summary = string.format("%s. %d digs this session%s (%d hits, %d misses).%s%s", status, session.digs,
        #parts > 0 and (": " .. table.concat(parts, ", ")) or "", session.hits, session.misses,
        pending and ("\nBuried for you: " .. tostring(pending) .. ".") or "", note ~= "" and ("\n" .. note) or "")
    if not (DigConfig and DigWorld) then
        label:SetText("The game's dig config could not be read.")
        return
    end
    if not Ui.on("AutoDig") then
        label:SetText("Off. " .. summary)
        return
    end
    label:SetText(summary)
    if left > 0 and os.clock() >= nextTry and not busy then
        nextTry = os.clock() + 20 -- a failed trip is not retried at once
        Life.spawn("dig:trip", digTrip)
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
end)

return {}
end

Modules["features/creatures"] = function(use)
-- Rewards tab: things in the world you break or pick up.
--
-- Island creatures (Shared.Game.IslandBreakableConfig): one per island, yours alone - Fluffy
-- Cloud, Giant Pumpkin, Glow Mushroom, Prickly Cactus, Crystal Cluster, Void Crystal. Each appears
-- at its spot (workspace.IslandBreakableSpots, one Vector3 attribute per spot) once you are within
-- 100 studs and it is ready (Data.IslandBreakables[spot] = ready-at), takes 20-35 hits, and pays
-- 150-400 taps of coins plus Honey Pot ingredients (the mushroom adds 4 Slime). It hops away when
-- hit, so you are kept beside it.
--
-- Events (Shared.Admin.WorldEventConfig, EggDropConfig, BreakableConfig): meteors from a Meteor
-- Shower and the Mystery Egg are breakables anyone can hit; Cloud Rain drops pickups you collect by
-- touching. Breakables of every kind take damage from your taps when you stand within TapRange (14
-- studs, 12 up or down) of them, so this keeps auto tap running while it works (Ui.tapDemand).

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local CollectionService = game:GetService("CollectionService")
local tab = Ui.Tabs.World
local RS = Env.ReplicatedStorage

local function load(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = RS
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local IslandBreakables = load("Shared", "Game", "IslandBreakableConfig")
local BreakableConfig = load("Shared", "Game", "BreakableConfig")
local WorldEventConfig = load("Shared", "Admin", "WorldEventConfig")
local EggDropConfig = load("Shared", "Admin", "EggDropConfig")

local TAG = BreakableConfig and BreakableConfig.Tag or "Breakable"
local ATTRS = BreakableConfig and BreakableConfig.Attributes or {
    Type = "BreakableType", Owner = "BreakableOwner", Rest = "BreakableRest", Broken = "BreakableBroken",
    Despawned = "BreakableDespawned", Size = "BreakableSize",
}
local CLOUD_TAG = WorldEventConfig and WorldEventConfig.Cloud and WorldEventConfig.Cloud.Tag or "CloudRainPickup"

-- Spots measured in the game, used until workspace.IslandBreakableSpots arrives.
local SPOT_FALLBACK = {
    SkyIsland = Vector3.new(85.9, -42.5, -1868.2),
    Autumn = Vector3.new(15.7, 882.1, -1910.3),
    Mushroom = Vector3.new(-138.8, 2018.1, -1700.9),
    Desert = Vector3.new(37.2, 3622.7, -1879.8),
    CrystalCave = Vector3.new(30.6, 5448.5, -1680.7),
    ShadowRelm = Vector3.new(-147.2, 7676.3, -1648.5),
}

local EVENT_TYPES = {}
for _, tier in pairs(WorldEventConfig and WorldEventConfig.Meteor and WorldEventConfig.Meteor.Tiers or {}) do
    if type(tier) == "table" and tier.Breakable then
        EVENT_TYPES[tier.Breakable] = "Meteor"
    end
end
EVENT_TYPES[EggDropConfig and EggDropConfig.Breakable or "MysteryEgg"] = "Mystery Egg"

local box = tab:AddGroupbox({ Side = "Right", Name = "Creatures and events", IconName = "swords" })
box:AddToggle("AutoCreatures", {
    Text = "Break island creatures",
    Default = false,
    Tooltip = "Visits each island's creature (Fluffy Cloud, Giant Pumpkin, Glow Mushroom, Prickly Cactus, Crystal Cluster, Void Crystal) when it is back and breaks it with taps: coins plus Honey Pot ingredients.",
})
Ui.automation("AutoCreatures", false)
box:AddToggle("AutoWorldEvents", {
    Text = "Meteors, Mystery Egg, Cloud Rain",
    Default = false,
    Tooltip = "During a Meteor Shower, a Mystery Egg drop or Cloud Rain, breaks the meteors and the egg and collects the cloud pickups.",
})
Ui.automation("AutoWorldEvents", false)
box:AddToggle("CreaturesReturn", {
    Text = "Return to where I was",
    Default = true,
})
local label = box:AddLabel("Off.", true)

local session = { creatures = 0, meteors = 0, eggs = 0, pickups = 0, note = "" }
local me = Env.LocalPlayer.UserId

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function spotPosition(id)
    local folder = workspace:FindFirstChild("IslandBreakableSpots")
    local value = folder and folder:GetAttribute(id)
    if typeof(value) == "Vector3" then
        return value
    end
    return SPOT_FALLBACK[id]
end

local function alive(breakable)
    return breakable.Parent ~= nil and breakable:GetAttribute(ATTRS.Broken) ~= true
        and breakable:GetAttribute(ATTRS.Despawned) ~= true
end

local function restOf(breakable)
    local rest = breakable:GetAttribute(ATTRS.Rest)
    if typeof(rest) == "Vector3" then
        return rest
    elseif typeof(rest) == "CFrame" then
        return rest.Position
    end
    local ok, position = pcall(function()
        return breakable:IsA("Model") and breakable:GetPivot().Position or breakable.Position
    end)
    return ok and position or nil
end

local function sizeOf(breakable)
    local size = breakable:GetAttribute(ATTRS.Size)
    return typeof(size) == "Vector3" and size or Vector3.new(6, 6, 6)
end

-- Your live creature of this type, if it has appeared.
local function ownCreature(kind)
    for _, breakable in ipairs(CollectionService:GetTagged(TAG)) do
        if breakable:GetAttribute(ATTRS.Owner) == me and breakable:GetAttribute(ATTRS.Type) == kind and alive(breakable) then
            return breakable
        end
    end
    return nil
end

local function eventBreakables()
    local list = {}
    for _, breakable in ipairs(CollectionService:GetTagged(TAG)) do
        local kind = breakable:GetAttribute(ATTRS.Type)
        if EVENT_TYPES[kind] and alive(breakable) then
            list[#list + 1] = breakable
        end
    end
    return list
end

local function cloudPickups()
    local list = {}
    for _, pickup in ipairs(CollectionService:GetTagged(CLOUD_TAG)) do
        if pickup:IsA("BasePart") and pickup.Parent then
            list[#list + 1] = pickup
        elseif pickup:IsA("Model") and pickup.PrimaryPart then
            list[#list + 1] = pickup.PrimaryPart
        end
    end
    return list
end

-- Stands you beside a breakable and lets the taps work until it breaks, it goes, or time runs out.
-- The stand point is re-taken every frame-ish from where the server says it rests, since island
-- creatures hop away from whoever hits them.
local function breakIt(breakable, seconds)
    local deadline = os.clock() + (seconds or 20)
    Ui.tapDemand = true
    local ok = pcall(function()
        while Life.alive and alive(breakable) and os.clock() < deadline do
            local rest = restOf(breakable)
            local hrp = root()
            if rest and hrp then
                local size = sizeOf(breakable)
                local side = math.max(size.X, size.Z) * 0.5 + 3
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(rest + Vector3.new(side, 0, 0), rest)
            end
            Life.wait(0.15)
        end
    end)
    Ui.tapDemand = false
    Env.elevate()
    return ok and not alive(breakable)
end

local function stream(position)
    Env.streamAround(position, 6)
end

local function readySpots(data)
    local list = {}
    if not (IslandBreakables and data) then
        return list
    end
    local now = workspace:GetServerTimeNow()
    for id, spot in pairs(IslandBreakables.Spots) do
        local unlocked = IslandBreakables.IsUnlocked(data, spot)
        if unlocked and IslandBreakables.GetReadyAt(data, id) <= now and spotPosition(id) then
            list[#list + 1] = { id = id, spot = spot }
        end
    end
    table.sort(list, function(a, b)
        return a.id < b.id
    end)
    return list
end

local function huntCreatures()
    for _, entry in ipairs(readySpots(Env.data())) do
        if not (Life.alive and Ui.on("AutoCreatures")) then
            break
        end
        local position = spotPosition(entry.id)
        stream(position)
        local hrp = root()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
        end
        local creature
        local deadline = os.clock() + 6
        repeat
            Life.wait(0.3)
            creature = ownCreature(entry.spot.Type)
        until creature or not Life.alive or os.clock() > deadline
        if creature then
            if breakIt(creature, 25) then
                session.creatures += 1
                session.note = "Broke the " .. tostring(entry.spot.Title) .. "."
            else
                session.note = "The " .. tostring(entry.spot.Title) .. " got away."
            end
        end
    end
end

-- A Mystery Egg lands on one island (EggDropService.Incoming) and stays EggDropConfig.Lifetime
-- seconds; the game's own "go to the egg" (Travel) takes you to it.
local eggUntil = 0
Life.spawn("creatures:egg-watch", function()
    Life.connect(Env.remote("EggDropService", "Incoming").OnClientEvent, function()
        eggUntil = os.clock() + (EggDropConfig and EggDropConfig.Lifetime or 240) + 10
    end)
    Life.connect(Env.remote("EggDropService", "Cracked").OnClientEvent, function()
        eggUntil = 0
    end)
    Life.connect(Env.remote("EggDropService", "FlewOff").OnClientEvent, function()
        eggUntil = 0
    end)
end)

local function eggNearby()
    for _, breakable in ipairs(eventBreakables()) do
        if EVENT_TYPES[breakable:GetAttribute(ATTRS.Type)] == "Mystery Egg" then
            return true
        end
    end
    return false
end

local eggRetryAt = 0
local function workEvents()
    if os.clock() < eggUntil and os.clock() >= eggRetryAt and not eggNearby() then
        Env.invoke("EggDropService", "Travel")
        local deadline = os.clock() + 6
        repeat
            Life.wait(0.3)
        until eggNearby() or not Life.alive or os.clock() > deadline
        if not eggNearby() then
            eggRetryAt = os.clock() + 20
        end
    end
    for _ = 1, 30 do
        if not (Life.alive and Ui.on("AutoWorldEvents")) then
            break
        end
        local targets = eventBreakables()
        if #targets == 0 then
            break
        end
        local hrp = root()
        table.sort(targets, function(a, b)
            local pa, pb = restOf(a), restOf(b)
            if not (hrp and pa and pb) then
                return false
            end
            return (pa - hrp.Position).Magnitude < (pb - hrp.Position).Magnitude
        end)
        local target = targets[1]
        local kind = EVENT_TYPES[target:GetAttribute(ATTRS.Type)]
        if breakIt(target, kind == "Mystery Egg" and 60 or 20) then
            if kind == "Mystery Egg" then
                session.eggs += 1
            else
                session.meteors += 1
            end
        end
    end
    for _, pickup in ipairs(cloudPickups()) do
        if not (Life.alive and Ui.on("AutoWorldEvents")) then
            break
        end
        local hrp = root()
        if hrp and pickup.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = pickup.CFrame
            Life.wait(0.25)
            if not pickup.Parent then
                session.pickups += 1
            end
        end
    end
end

local function eventsPending()
    return #eventBreakables() > 0 or #cloudPickups() > 0
        or (os.clock() < eggUntil and os.clock() >= eggRetryAt and not eggNearby())
end

local busy = false
local function trip(kind)
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "creatures"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(function()
        Ui.status = kind == "events" and "World event" or "Hunting creatures"
        if kind == "events" then
            workEvents()
        else
            huntCreatures()
        end
    end)
    Env.elevate()
    Ui.tapDemand = false
    if not ok then
        Life.errors["creatures:trip"] = tostring(err)
        session.note = "Error: " .. tostring(err)
    end
    if home and Ui.on("CreaturesReturn") then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    if Ui.status == "World event" or Ui.status == "Hunting creatures" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

local nextCreatures, nextEvents = 0, 0
Life.loop("creatures:auto", 1, function()
    local data = Env.data()
    local ready = readySpots(data)
    local lines = {}
    if IslandBreakables and data then
        local now = workspace:GetServerTimeNow()
        local soonest
        for id in pairs(IslandBreakables.Spots) do
            local at = IslandBreakables.GetReadyAt(data, id)
            if at > now and (not soonest or at < soonest) then
                soonest = at
            end
        end
        lines[1] = string.format("%d creatures ready%s.", #ready,
            soonest and string.format(", next in %d:%02d", (soonest - now) // 60, math.floor((soonest - now) % 60)) or "")
    end
    lines[#lines + 1] = string.format("This session: %d creatures, %d meteors, %d Mystery Eggs, %d cloud pickups.",
        session.creatures, session.meteors, session.eggs, session.pickups)
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    label:SetText(table.concat(lines, "\n"))
    if busy or Ui.travelling or Ui.hatchMoving then
        return
    end
    if Ui.on("AutoWorldEvents") and os.clock() >= nextEvents and eventsPending() then
        nextEvents = os.clock() + 5 -- whatever could not be reached is tried again shortly, not every second
        Life.spawn("creatures:events", trip, "events")
    elseif Ui.on("AutoCreatures") and #ready > 0 and os.clock() >= nextCreatures then
        nextCreatures = os.clock() + 30 -- a creature that would not show is not chased again at once
        Life.spawn("creatures:hunt", trip, "creatures")
    end
end)

-- The admins' falling Lucky Block event (LuckyBlockEventService: CreateFalling, CollectRequested,
-- PlayCutscene) brings its own client code only while it runs, so how a block is picked up is not
-- known yet. Until it is, what the event sends is written to Abysall/TapSimulator/
-- luckyblock-events.txt, so the next one can be automated from real data.
Life.spawn("creatures:luckyblock-log", function()
    local service = Env.ReplicatedStorage.RemoteServices:FindFirstChild("LuckyBlockEventService")
    local events = service and service:FindFirstChild("RE")
    local files = Env.files
    if not (events and files.writefile and files.readfile and files.isfile and files.isfolder and files.makefolder) then
        return
    end
    local path = "Abysall/TapSimulator/luckyblock-events.txt"
    local function describe(value, depth)
        depth = depth or 0
        if typeof(value) == "Instance" then
            return "<" .. value.ClassName .. " " .. value:GetFullName() .. ">"
        elseif type(value) ~= "table" then
            return typeof(value) .. ":" .. tostring(value)
        elseif depth > 3 then
            return "{...}"
        end
        local parts = {}
        for key, item in pairs(value) do
            parts[#parts + 1] = tostring(key) .. "=" .. describe(item, depth + 1)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    local function record(name, ...)
        local args = table.pack(...)
        local parts = {}
        for index = 1, args.n do
            parts[#parts + 1] = describe(args[index])
        end
        pcall(function()
            for _, folder in ipairs({ "Abysall", "Abysall/TapSimulator" }) do
                if not files.isfolder(folder) then
                    files.makefolder(folder)
                end
            end
            local old = files.isfile(path) and files.readfile(path) or ""
            if #old < 200000 then
                files.writefile(path, old .. string.format("[%s] %s %s\n", os.date("!%H:%M:%S"), name, table.concat(parts, " | ")))
            end
        end)
        Env.elevate()
        session.note = "Lucky Block event seen (" .. name .. "); recorded for later."
    end
    for _, remote in ipairs(events:GetChildren()) do
        if remote:IsA("RemoteEvent") then
            Life.connect(remote.OnClientEvent, function(...)
                record(remote.Name, ...)
            end)
        end
    end
end)

Life.onCleanup(function()
    Ui.tapDemand = false
    if busy then
        Ui.travelling = false
    end
end)

return {}
end

Modules["features/defense"] = function(use)
-- Rewards tab: Pet Defense, the wave defense on Mushroom island (ColosseumService in the game's
-- code). Pets walk three tracks toward your bone pit; a tap hits the one closest to it, and every
-- few seconds a critical does 10x damage and pushes it back. Three escapes end the run. Every
-- cleared wave raises the relic you win (a ring with click multiplier and other boosts) and adds
-- treats, dials and, from wave 11, totems. One run every 30 minutes (Data.Colosseum.Cooldown).
--
-- A run is played through the game's own Pet Defense screen so you can watch it:
--   start     the controller's WaveDefenseForceStart handler (its attemptStartGame: the arena door,
--             StartWaveDefense, the board, the critical buttons). It needs you at the arena
--             entrance, so the hub stands you there first; the server then puts you in the arena.
--   taps      ColosseumClientAdapter.Signals "PlayerTapped", the game's own tap button: it picks
--             the pet closest to the pit, keeps the game's 0.14s tap cooldown and shows the hit.
--   critical  the critical button the game spawns every 5-10 seconds, pressed through its own
--             handler.
-- Without getconnections the same run is played on the remotes directly (StartWaveDefense,
-- AttackOpponent, CriticalAttackOpponent), and the fight is not drawn.
--
-- When the run ends the pending reward is claimed: ClaimMinigameReward "replace" takes the new
-- relic, "keep" keeps yours, and the treats and items come either way.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local Options = Ui.Options
local RS = Env.ReplicatedStorage
local tab = Ui.Tabs.Minigames

local COOLDOWN = 1800
local TAP_GAP = 0.15 -- the game's own cooldown is ClickCooldown - grace + 0.02 = 0.14s
local RUN_LIMIT = 20 * 60
local ENTRANCE_FALLBACK = Vector3.new(-170, 2020, -1795)
local RING_ORDER = { BronzeRing = 1, SilverRing = 2, GoldRing = 3, PlatinumRing = 4, DiamondRing = 5 }

local function load(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = RS
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local World = load("Shared", "Minigames", "ColosseumWorld")
local Adapter = load("Controllers", "Minigames", "ColosseumClientAdapter")

local KEEP_BETTER, LET_ME = "Keep the better ring", "Let me choose"
local box = tab:AddGroupbox({ Side = "Left", Name = "Pet Defense", IconName = "shield" })
box:AddToggle("AutoDefense", {
    Text = "Auto Pet Defense",
    Default = false,
    Tooltip = "Plays Pet Defense on Mushroom island every 30 minutes, to the last heart, and comes back. Auto hatch pauses while a run lasts (a few minutes).",
})
Ui.automation("AutoDefense", false)
box:AddSlider("DefenseStopAt", {
    Text = "Stop at wave",
    Default = 0,
    Min = 0,
    Max = 60,
    Rounding = 0,
    Tooltip = "0 plays until the last heart. A lower stop banks the run sooner (the relic is rolled from the wave you reach).",
})
box:AddDropdown("DefenseRelic", {
    Text = "New relic",
    Values = { KEEP_BETTER, LET_ME },
    Default = KEEP_BETTER,
    Tooltip = "Keep the better ring: a higher ring wins (Bronze, Silver, Gold, Platinum, Diamond), then the bigger click multiplier. Let me choose leaves the game's reward screen open.",
})
box:AddToggle("DefenseReturn", {
    Text = "Return to where I was",
    Default = true,
})
local label = box:AddLabel("Auto Pet Defense is off.", true)

local session = { runs = 0, best = 0, last = nil, note = "" }

local function colosseum(data)
    return data and type(data.Colosseum) == "table" and data.Colosseum or {}
end

local function readyIn(data)
    local cooldown = tonumber(colosseum(data).Cooldown) or 0
    return math.max(0, cooldown + COOLDOWN - os.time())
end

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- The game's own handler on one of its remotes (ReplicatedStorage code, not the hub's).
local function gameHandler(signal)
    if type(getconnections) ~= "function" then
        return nil
    end
    local ok, connections = pcall(getconnections, signal)
    for _, connection in ipairs(ok and type(connections) == "table" and connections or {}) do
        local fine, source = pcall(function()
            return connection.Function and debug.info(connection.Function, "s")
        end)
        if fine and type(source) == "string" and source:find("^ReplicatedStorage%.") then
            return connection.Function
        end
    end
    return nil
end

local function standAtEntrance()
    local hrp = root()
    if not hrp then
        return false
    end
    local entrance = World and World.GetEntrance()
    if not entrance then
        Env.streamAround(ENTRANCE_FALLBACK, 10)
        hrp.CFrame = CFrame.new(ENTRANCE_FALLBACK + Vector3.new(0, 4, 0))
        local deadline = os.clock() + 8
        while Life.alive and not entrance and os.clock() < deadline do
            Life.wait(0.2)
            entrance = World and World.GetEntrance()
        end
    end
    if not entrance then
        return false
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = entrance.CFrame + Vector3.new(0, 3, 0)
    Life.wait(0.8)
    return true
end

-- The game's Pet Defense screens. Its wave events show the wave board whether or not its own
-- controller started the run, and only that controller hides it again, so a run it did not draw
-- (the direct mode, a run cut short) would leave the board over the screen. Outside a run the
-- game has these off.
local SCREENS = { "WaveDefense", "WaveStartMessage" }
local function clearScreens()
    if Env.LocalPlayer:GetAttribute("ColosseumActive") == true then
        return
    end
    local gui = Env.LocalPlayer:FindFirstChildOfClass("PlayerGui")
    for _, name in ipairs(SCREENS) do
        local screen = gui and gui:FindFirstChild(name)
        if screen and screen:IsA("ScreenGui") and screen.Enabled then
            screen.Enabled = false
        end
    end
end

-- The run, as the server tells it.
local run
local function newRun()
    return { active = true, over = false, wave = 0, hearts = 3, opponents = {}, result = nil }
end

Life.spawn("defense:events", function()
    local function on(name, handler)
        Life.connect(Env.remote("ColosseumService", name).OnClientEvent, function(payload)
            if run and type(payload) == "table" then
                handler(payload)
            end
        end)
    end
    on("WaveDefenseOpponentSpawned", function(opponent)
        if opponent.Id ~= nil then
            run.opponents[opponent.Id] = opponent
        end
    end)
    on("WaveDefenseOpponentDefeated", function(event)
        run.opponents[event.OpponentId] = nil
    end)
    on("WaveDefenseHeartLost", function(event)
        run.opponents[event.OpponentId] = nil
        run.hearts = tonumber(event.Hearts) or run.hearts
    end)
    on("WaveDefenseWaveComplete", function(event)
        run.wave = tonumber(event.WaveCompleted) or run.wave
        run.hearts = tonumber(event.Hearts) or run.hearts
    end)
    on("WaveDefenseGameOver", function(event)
        run.over = true
        run.result = event
    end)
end)

-- The pet nearest the pit, for the direct mode.
local function urgent()
    local now = workspace:GetServerTimeNow()
    local best
    for _, opponent in pairs(run.opponents) do
        if (tonumber(opponent.SpawnTime) or 0) <= now
            and (not best or (tonumber(opponent.ArrivalTime) or math.huge) < (tonumber(best.ArrivalTime) or math.huge)) then
            best = opponent
        end
    end
    return best
end

-- Presses the game's critical button if one is up: "pressed", "none", or "unreachable" when its
-- handler cannot be read (the run then sends criticals itself).
local function pressCritical()
    local gui = Env.LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local hud = gui and gui:FindFirstChild("WaveDefense")
    local criticals = hud and hud:FindFirstChild("WaveHUD") and hud.WaveHUD:FindFirstChild("Criticals")
    local active = criticals and criticals:FindFirstChild("CriticalActive")
    local button = active and active:FindFirstChild("Button")
    if not button then
        return "none"
    end
    local handler = gameHandler(button.Activated)
    if handler then
        Life.spawn("defense:critical", handler)
        return "pressed"
    end
    return "unreachable"
end

local function attackDirect(critical)
    local target = urgent()
    if not target then
        return
    end
    local ok, result = Env.invoke("ColosseumService", critical and "CriticalAttackOpponent" or "AttackOpponent", target.Id)
    if ok and type(result) == "table" then
        if result.Defeated then
            run.opponents[target.Id] = nil
        elseif result.NewArrivalTime then
            target.ArrivalTime = result.NewArrivalTime
        end
    end
end

-- Plays one run to its end. Returns true when it was played.
local function playRun()
    local forceStart = gameHandler(Env.remote("ColosseumService", "WaveDefenseForceStart").OnClientEvent)
    local visual = forceStart ~= nil and Adapter ~= nil and type(Adapter.Signals) == "table"
    run = newRun()
    if visual then
        Life.spawn("defense:start", forceStart)
        local deadline = os.clock() + 15
        while Life.alive and os.clock() < deadline and Env.LocalPlayer:GetAttribute("ColosseumActive") ~= true do
            Life.wait(0.2)
        end
        if Env.LocalPlayer:GetAttribute("ColosseumActive") ~= true then
            session.note = "The game did not start the run."
            run = nil
            return false
        end
    else
        local ok, start = Env.invoke("ColosseumService", "StartWaveDefense")
        if not ok or type(start) ~= "table" or start.Error or start.OnCooldown then
            session.note = "Start refused: " .. tostring(type(start) == "table" and (start.Error or "on cooldown") or start)
            run = nil
            return false
        end
        run.hearts = tonumber(start.Hearts) or 3
        for _, opponent in ipairs(type(start.PendingSpawns) == "table" and start.PendingSpawns or {}) do
            if opponent.Id ~= nil then
                run.opponents[opponent.Id] = opponent
            end
        end
    end
    Ui.status = "Playing Pet Defense"
    local started = os.clock()
    local nextCritical = os.clock() + 5 + math.random() * 3
    local ownCriticals = not visual
    while Life.alive and not run.over and os.clock() - started < RUN_LIMIT do
        local stopAt = tonumber(Options.DefenseStopAt.Value) or 0
        if not Ui.on("AutoDefense") or (stopAt > 0 and run.wave >= stopAt) then
            Env.invoke("ColosseumService", "EndWaveDefense")
            break
        end
        if visual then
            Env.call(Adapter.Signals.Fire, "PlayerTapped")
            if pressCritical() == "unreachable" then
                ownCriticals = true
            end
        end
        if ownCriticals and os.clock() >= nextCritical then
            nextCritical = os.clock() + 5 + math.random() * 3
            attackDirect(true)
        elseif not visual then
            attackDirect(false)
        end
        if not visual then
            clearScreens() -- a board with no pets on it is only in the way
        end
        Life.wait(TAP_GAP)
    end
    if not run.over and os.clock() - started >= RUN_LIMIT then
        Env.invoke("ColosseumService", "EndWaveDefense")
    end
    local deadline = os.clock() + 8
    while Life.alive and not run.over and os.clock() < deadline do
        Life.wait(0.2)
    end
    local reached = tonumber(type(run.result) == "table" and run.result.WavesCompleted) or run.wave
    session.runs += 1
    session.best = math.max(session.best, reached)
    session.last = reached
    if not visual then
        Env.invoke("ColosseumService", "ReturnFromArena")
    end
    run = nil
    return true
end

-- A ring's worth: its tier first, then its click multiplier, then everything else it gives.
local function ringScore(relic)
    if type(relic) ~= "table" then
        return -1
    end
    local click, rest = 0, 0
    for _, boost in ipairs(type(relic.Boosts) == "table" and relic.Boosts or {}) do
        local value = tonumber(boost.Value) or 0
        if boost.Type == "ClickMultiplier" then
            click += value
        else
            rest += value
        end
    end
    return (RING_ORDER[relic.Name] or 0) * 1000 + click * 100 + rest
end

local function claimReward()
    if Options.DefenseRelic.Value == LET_ME then
        return
    end
    local deadline = os.clock() + 10
    local pending
    repeat
        pending = colosseum(Env.data()).PendingReward
        if not pending then
            Life.wait(0.3)
        end
    until pending or not Life.alive or os.clock() > deadline
    if type(pending) ~= "table" then
        return
    end
    local current = colosseum(Env.data()).Relic
    local choice = ringScore(pending.NewRelic) > ringScore(current) and "replace" or "keep"
    local ok, result = Env.invoke("ColosseumService", "ClaimMinigameReward", choice)
    if ok and result then
        local relic = type(pending.NewRelic) == "table" and pending.NewRelic.Name or "relic"
        session.note = choice == "replace" and ("Took the new " .. tostring(relic) .. ".")
            or ("Kept your ring over the new " .. tostring(relic) .. ".")
    else
        session.note = "Reward claim refused; it is waiting in the game's reward screen."
    end
end

local busy = false
local function trip()
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "defense"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(function()
        Ui.status = "Going to Pet Defense"
        if not standAtEntrance() then
            session.note = "Could not reach the Pet Defense arena."
            return
        end
        if playRun() then
            Life.wait(3) -- the game's own end screen and its trip out of the arena
            claimReward()
        end
    end)
    Env.elevate()
    if not ok then
        Life.errors["defense:trip"] = tostring(err)
        session.note = "Pet Defense error: " .. tostring(err)
    end
    run = nil
    -- The game's end screen runs ~4s (banner, fade, its trip out of the arena); then nothing of the
    -- run may stay on screen.
    local settled = os.clock() + 6
    while Life.alive and Env.LocalPlayer:GetAttribute("ColosseumActive") == true and os.clock() < settled do
        Life.wait(0.2)
    end
    clearScreens()
    if home and Ui.on("DefenseReturn") then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    if Ui.status == "Playing Pet Defense" or Ui.status == "Going to Pet Defense" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

local nextTry = 0
Life.loop("defense:auto", 1, function()
    local data = Env.data()
    if not data then
        return
    end
    -- Leftovers from a run that was not drawn (an older hub, a cut-short run) are cleared outside
    -- a run, whether or not auto Pet Defense is on.
    if not busy then
        clearScreens()
    end
    local wait = readyIn(data)
    local best = tonumber(colosseum(data).BestWave) or 0
    local lines = {}
    if run then
        lines[1] = string.format("Wave %d, %d hearts left.", run.wave + 1, run.hearts)
    elseif wait > 0 then
        lines[1] = string.format("Next run in %d:%02d. Best wave %d.", wait // 60, wait % 60, best)
    else
        lines[1] = string.format("A run is ready. Best wave %d.", best)
    end
    if session.runs > 0 then
        lines[#lines + 1] = string.format("%d runs this session, last reached wave %d.", session.runs, session.last or 0)
    end
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    if not Ui.on("AutoDefense") then
        label:SetText("Off. " .. table.concat(lines, "\n"))
        return
    end
    label:SetText(table.concat(lines, "\n"))
    -- A reward left from an earlier run (or one played by hand) is claimed where you stand.
    if colosseum(data).PendingReward and not busy and not run and Options.DefenseRelic.Value ~= LET_ME
        and os.clock() >= nextTry then
        nextTry = os.clock() + 30
        Life.spawn("defense:claim", claimReward)
        return
    end
    if wait == 0 and not busy and os.clock() >= nextTry and not colosseum(data).PendingReward then
        nextTry = os.clock() + 60 -- a refused start is not retried at once
        Life.spawn("defense:trip", trip)
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
end)

return {}
end

Modules["features/minigames"] = function(use)
-- Rewards tab: Memory Match and Boingo's quest.
--
-- Memory Match (MemoryMatchService, pad at workspace.MemoryMatch.TouchToPlay, within 24 studs):
-- Open(true) deals a board of 12 cards (6 pet pairs) once every 30 minutes; Flip(boardId, card)
-- turns one over and answers with the board, the flipped card's Pet showing, and after the second
-- card of a turn whether it was a Match. Cards cannot be flipped before UnlockAt. Played with a
-- perfect memory: a known pair is taken at once, an unknown card is turned first, and its partner
-- is taken if it was seen before.
--
-- Boingo's quest (Shared.Quests.NpcQuestConfig, line "BouncyBall"): NpcQuestService.Talk { Line }
-- starts and advances it, Collect { Line, Core } picks up each of the 5 Bounce Cores within 14
-- studs of it. The other steps (tap 1,000 times, hatch 20 eggs, unlock Sky Island) are progress you
-- make anyway. Reward: 5 Slime.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local tab = Ui.Tabs.Minigames
local RS = Env.ReplicatedStorage

local PAD = Vector3.new(-3118.3, -526.1, -2179.3)
local LINE = "BouncyBall"

local NpcQuestConfig
do
    local ok, module = Env.call(function()
        return require(RS.Shared.Quests.NpcQuestConfig)
    end)
    NpcQuestConfig = ok and type(module) == "table" and module or nil
end

local box = tab:AddGroupbox({ Side = "Left", Name = "Memory Match and quests", IconName = "gamepad-2" })
box:AddToggle("AutoMemory", {
    Text = "Play Memory Match",
    Default = false,
    Tooltip = "Plays Memory Match (by the spawn, every 30 minutes) with a perfect memory, then comes back.",
})
Ui.automation("AutoMemory", false)
box:AddToggle("AutoBoingo", {
    Text = "Do Boingo's quest",
    Default = false,
    Tooltip = "Talks to Boingo and picks up his 5 Bounce Cores around the spawn. Reward: 5 Slime. Once.",
})
Ui.automation("AutoBoingo", false)
-- Off until the game's Bouncy Obby can be finished: the live course has 3 of its 4 checkpoints and
-- no finish line (swept end to end), so a run can only fail. runObby below is kept for when it is
-- fixed; uncomment this toggle and the matching branch in the auto loop.
--[[
box:AddToggle("AutoObby", {
    Text = "Get the Bouncy Ball license",
    Default = false,
    Tooltip = "Once you have 20 Slime (the Glow Mushroom and Boingo give it), crafts a key, runs the Bouncy Obby checkpoint by checkpoint and finishes it, which earns the Bouncy Ball license. The run takes the game's minimum 45 seconds.",
})
Ui.automation("AutoObby", false)
]]
local label = box:AddLabel("", true)

local session = { played = 0, won = 0, note = "", boingo = "" }

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function teleport(position)
    Env.streamAround(position, 5)
    local hrp = root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
    end
end

-- Memory Match ---------------------------------------------------------------------------------

local function memoryCall(name, ...)
    for _ = 1, 6 do
        local ok, result = Env.invoke("MemoryMatchService", name, ...)
        if ok and type(result) == "table" and result.Error == "Please wait." then
            Life.wait(0.6)
        else
            return ok and type(result) == "table" and result or nil
        end
    end
    return nil
end

local function waitUnlock(state)
    local unlock = tonumber(state and state.UnlockAt) or 0
    local wait = unlock - workspace:GetServerTimeNow()
    if wait > 0 then
        Life.wait(wait + 0.15)
    end
end

local function playBoard(state)
    local known = {} -- card -> pet, for cards seen and not matched
    local function remember(board)
        for index, card in pairs(type(board.Cards) == "table" and board.Cards or {}) do
            index = tonumber(index)
            if index and type(card) == "table" then
                if card.Matched then
                    known[index] = nil
                elseif card.Pet then
                    known[index] = card.Pet
                end
            end
        end
    end
    local function unmatched(board)
        local list = {}
        for index, card in pairs(type(board.Cards) == "table" and board.Cards or {}) do
            index = tonumber(index)
            if index and type(card) == "table" and not card.Matched then
                list[#list + 1] = index
            end
        end
        table.sort(list)
        return list
    end
    local function flip(board, index)
        waitUnlock(board)
        local result = memoryCall("Flip", board.Id, index)
        if result then
            remember(result)
        end
        return result
    end
    local function knownPair(board)
        local open = unmatched(board)
        for a = 1, #open do
            for b = a + 1, #open do
                local pa, pb = known[open[a]], known[open[b]]
                if pa and pa == pb then
                    return open[a], open[b]
                end
            end
        end
        return nil
    end
    local function unknownCard(board, except)
        for _, index in ipairs(unmatched(board)) do
            if known[index] == nil and index ~= except then
                return index
            end
        end
        return nil
    end
    local function partnerOf(board, index)
        for _, other in ipairs(unmatched(board)) do
            if other ~= index and known[other] and known[other] == known[index] then
                return other
            end
        end
        return nil
    end

    remember(state)
    local board = state
    for _ = 1, 40 do
        if not (Life.alive and board and board.Outcome == "Playing") then
            break
        end
        local a, b = knownPair(board)
        if a then
            board = flip(board, a) or board
            board = flip(board, b) or board
        else
            local first = unknownCard(board)
            if not first then
                break
            end
            board = flip(board, first) or board
            local second = partnerOf(board, first) or unknownCard(board, first)
            if not second then
                break
            end
            board = flip(board, second) or board
        end
    end
    return board
end

local function playMemory()
    teleport(PAD)
    Life.wait(0.8)
    local state = memoryCall("Open", true)
    if not state then
        session.note = "Memory Match did not open."
        return
    end
    if state.Outcome ~= "Playing" then
        session.note = "Memory Match: " .. tostring(state.Error or state.Outcome)
        return
    end
    local final = playBoard(state)
    session.played += 1
    local outcome = final and final.Outcome or "?"
    if outcome == "Won" or (final and tonumber(final.Pairs) == 6) then
        session.won += 1
    end
    session.note = string.format("Memory Match: %s in %s tries.", tostring(outcome), tostring(final and final.Attempts or "?"))
end

-- Boingo ---------------------------------------------------------------------------------------

local function questLine()
    if not NpcQuestConfig then
        return nil
    end
    local ok, line = Env.call(NpcQuestConfig.LineForNpc, "Boingo")
    if ok and type(line) == "table" then
        return line
    end
    return type(NpcQuestConfig.Lines) == "table" and NpcQuestConfig.Lines[LINE] or nil
end

local function boingoState(data)
    local line = questLine()
    if not (line and data) then
        return nil
    end
    local ok, entry = Env.call(NpcQuestConfig.GetEntry, data, line.Id)
    entry = ok and entry or nil
    local okStep, step = Env.call(NpcQuestConfig.CurrentStep, line, entry)
    return line, entry, okStep and step or nil
end

local function doBoingo()
    for _ = 1, 12 do
        local data = Env.data()
        local line, entry, step = boingoState(data)
        if not line then
            session.boingo = "Quest config could not be read."
            return
        end
        if entry and entry.Done == true then
            session.boingo = "Boingo's quest is done."
            return
        end
        if entry == nil or (step and step.Kind == "Talk") then
            local ok, result = Env.invoke("NpcQuestService", "Talk", { Line = line.Id })
            if not (ok and type(result) == "table" and result.Success == true) then
                session.boingo = "Boingo: " .. tostring(type(result) == "table" and (result.Reason or result.Error) or result)
                return
            end
        elseif step and step.Kind == "Collect" then
            local okCores, cores = Env.call(NpcQuestConfig.OpenCores, line, entry)
            local list = okCores and type(cores) == "table" and cores or {}
            if #list == 0 then
                Env.invoke("NpcQuestService", "Talk", { Line = line.Id })
            end
            for _, core in ipairs(list) do
                if typeof(core.Position) == "Vector3" then
                    teleport(core.Position)
                    Life.wait(0.6)
                    Env.invoke("NpcQuestService", "Collect", { Line = line.Id, Core = core.Id })
                    Life.wait(0.3)
                end
            end
        else
            -- a progress step: done means Boingo moves you on when you talk to him
            local okDone, done = Env.call(NpcQuestConfig.IsStepComplete, line, entry, data)
            if okDone and done then
                Env.invoke("NpcQuestService", "Talk", { Line = line.Id })
            else
                session.boingo = "Boingo: waiting on \"" .. tostring(step and step.Title) .. "\"."
                return
            end
        end
        Life.wait(0.5)
    end
end

-- Bouncy Obby ----------------------------------------------------------------------------------
--
-- BouncyObbyService: CraftKey turns 20 Slime into a key, Enter puts you on the course, Reach
-- { Index } saves each checkpoint (parts with a CheckpointIndex attribute in workspace.BouncyObby),
-- Finish on the part marked Finish ends the run - refused as "TooFast" before MinFinishSeconds (45)
-- or "MissedCheckpoints". The first finish unlocks the Bouncy Ball license (Data.Unlocks).

local ObbyConfig
do
    local ok, module = Env.call(function()
        return require(RS.Shared.Game.BouncyObbyConfig)
    end)
    ObbyConfig = ok and type(module) == "table" and module or nil
end

local function obbyCall(name, payload)
    local ok, result
    if payload ~= nil then
        ok, result = Env.invoke("BouncyObbyService", name, payload)
    else
        ok, result = Env.invoke("BouncyObbyService", name)
    end
    return ok and type(result) == "table" and result or {}
end

-- The course is ~2,400 x 2,000 studs and only streams in 200 studs around you, so its checkpoints
-- and finish are found by sweeping it once; what was found is kept for later runs (it is built by
-- the server, the same every time).
local obbySpots = Env.genv.__AbysallTapSimulatorObbySpots or { checkpoints = {}, finish = nil }
Env.genv.__AbysallTapSimulatorObbySpots = obbySpots

local function obbyModel()
    return workspace:FindFirstChild(ObbyConfig and ObbyConfig.ModelName or "BouncyObby")
end

local function obbyCount()
    local count = tonumber(workspace:GetAttribute("BouncyObbyCheckpoints")) or 4
    local found = 0
    for _ in pairs(obbySpots.checkpoints) do
        found += 1
    end
    return found, count
end

local function obbyScan()
    local model = obbyModel()
    for _, part in ipairs(model and model:GetDescendants() or {}) do
        if part:IsA("BasePart") then
            local index = part:GetAttribute("CheckpointIndex")
            if type(index) == "number" then
                obbySpots.checkpoints[index] = part.Position
            elseif part:GetAttribute("Finish") == true then
                obbySpots.finish = part.Position
            end
        end
    end
end

local function streamAround(position, seconds)
    Env.streamAround(position, seconds)
end

local function obbySweep()
    obbyScan()
    local found, count = obbyCount()
    if found >= count and obbySpots.finish then
        return true
    end
    local model = obbyModel()
    if not model then
        return false
    end
    local ok, center, size = pcall(function()
        local cframe, extents = model:GetBoundingBox()
        return cframe.Position, extents
    end)
    if not ok then
        return false
    end
    local low, high = center - size / 2, center + size / 2
    -- 250-stud steps keep every point of the course within the 200-stud stream of one visit
    for y = low.Y + 100, high.Y, 250 do
        for x = low.X + 125, high.X, 250 do
            for z = low.Z + 125, high.Z, 250 do
                if not Life.alive then
                    return false
                end
                local point = Vector3.new(x, y, z)
                streamAround(point, 2)
                local hrp = root()
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = CFrame.new(point)
                end
                Life.wait(0.3)
                obbyScan()
                found, count = obbyCount()
                if found >= count and obbySpots.finish then
                    return true
                end
            end
        end
    end
    return false
end

local function hasLicense(data)
    return ObbyConfig and ObbyConfig.HasLicense(data) or false
end

local function slime(data)
    return ObbyConfig and ObbyConfig.SlimeOwned(data) or 0
end

local function runObby()
    local data = Env.data()
    if not data or hasLicense(data) then
        return
    end
    local progress = ObbyConfig.GetProgress(data)
    if not progress.Key then
        local crafted = obbyCall("CraftKey")
        if crafted.Success ~= true then
            session.note = "Obby key: " .. tostring(crafted.Reason or crafted.Error or "refused")
            return
        end
    end
    local entered = obbyCall("Enter")
    if entered.Success ~= true then
        session.note = "Obby: " .. tostring(entered.Reason or entered.Error or "could not enter")
        return
    end
    local started = os.clock()
    local deadline = os.clock() + 15
    repeat
        Life.wait(0.5)
    until obbyModel() or not Life.alive or os.clock() > deadline
    if not obbySweep() then
        local found, count = obbyCount()
        session.note = string.format("Obby: found %d of %d checkpoints%s; leaving, the key is kept.", found, count,
            obbySpots.finish and "" or " and no finish")
        obbyCall("Leave")
        return
    end
    local order = {}
    for index, position in pairs(obbySpots.checkpoints) do
        order[#order + 1] = { index = index, position = position }
    end
    table.sort(order, function(a, b)
        return a.index < b.index
    end)
    local reached = ObbyConfig.GetProgress(Env.data()).Reached or 0
    for _, checkpoint in ipairs(order) do
        if not Life.alive then
            return
        end
        if checkpoint.index > reached then
            streamAround(checkpoint.position, 2)
            local hrp = root()
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(checkpoint.position + Vector3.new(0, 3, 0))
            end
            Life.wait(0.6)
            local result = obbyCall("Reach", { Index = checkpoint.index })
            if result.Success ~= true then
                session.note = string.format("Obby checkpoint %d: %s.", checkpoint.index, tostring(result.Reason or "refused"))
            end
            Life.wait(2)
        end
    end
    -- The game refuses a finish sooner than MinFinishSeconds into the run ("TooFast").
    local minimum = (ObbyConfig.MinFinishSeconds or 45) + 2
    while Life.alive and os.clock() - started < minimum do
        Life.wait(0.5)
    end
    streamAround(obbySpots.finish, 2)
    local hrp = root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(obbySpots.finish + Vector3.new(0, 3, 0))
    end
    Life.wait(0.6)
    local finished = obbyCall("Finish")
    session.note = finished.Success == true and "Bouncy Obby finished: license earned."
        or ("Obby finish: " .. tostring(finished.Reason or "refused") .. " (the key is kept).")
    obbyCall("Leave")
end

-- Trips ----------------------------------------------------------------------------------------

local busy = false
local function trip(job)
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "minigames"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(job)
    Env.elevate()
    if not ok then
        Life.errors["minigames:trip"] = tostring(err)
        session.note = "Error: " .. tostring(err)
    end
    if home then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    Ui.travelling = false
    busy = false
end

local nextMemory, nextBoingo, nextObby = 0, 0, 0
Life.loop("minigames:auto", 2, function()
    local data = Env.data()
    if not data then
        return
    end
    local memory = type(data.MemoryMatch) == "table" and data.MemoryMatch or {}
    local wait = math.max(0, (tonumber(memory.NextPlay) or 0) - workspace:GetServerTimeNow())
    local lines = {
        wait > 0 and string.format("Memory Match in %d:%02d. Won %d.", wait // 60, math.floor(wait % 60), tonumber(memory.Wins) or 0)
            or string.format("Memory Match is ready. Won %d.", tonumber(memory.Wins) or 0),
    }
    local _, entry, step = boingoState(data)
    lines[#lines + 1] = entry and entry.Done and "Boingo's quest: done."
        or ("Boingo's quest: " .. (entry and step and tostring(step.Title) or "not started") .. ".")
    for _, note in ipairs({ session.note, session.boingo }) do
        if note ~= "" then
            lines[#lines + 1] = note
        end
    end
    label:SetText(table.concat(lines, "\n"))
    if busy or Ui.travelling or Ui.hatchMoving then
        return
    end
    if Ui.on("AutoMemory") and wait <= 0 and os.clock() >= nextMemory then
        nextMemory = os.clock() + 60
        Life.spawn("minigames:memory", trip, playMemory)
    elseif Ui.on("AutoBoingo") and not (entry and entry.Done) and os.clock() >= nextBoingo then
        nextBoingo = os.clock() + 120
        Life.spawn("minigames:boingo", trip, doBoingo)
    --[[ Bouncy Obby: see the commented-out toggle above.
    elseif Ui.on("AutoObby") and ObbyConfig and not hasLicense(data) and os.clock() >= nextObby
        and (slime(data) >= (ObbyConfig.KeyCost or 20) or ObbyConfig.GetProgress(data).Key) then
        nextObby = os.clock() + 300
        Life.spawn("minigames:obby", trip, runObby)
    ]]
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
end)

return {
    -- Plays a board now, whatever the timer says (a board left half-played can be finished).
    memory = function()
        Life.spawn("minigames:memory", trip, playMemory)
    end,
}
end

Modules["features/mining"] = function(use)
-- Rewards tab: the mine under Crystal Cave (MiningService). A 20 x 20 x 25 block mine per player,
-- fresh every day. Ores fill your bag; selling them gives mining coins, which buy better pickaxes
-- and bags and, in the daily shop, packs of real Coins and Gems. Clearing 25/50/75/100% of the
-- mine pays milestone Coins and Gems once a day (MiningConfig.Milestones).
--
-- Everything goes through the game's own mine so it shows as you would play it:
--   enter   standing in the portal makes the game's MiningController travel in (Enter) and draw
--           the mine;
--   mine    the controller's TouchTapInWorld handler is the game's "tap a block" input: the camera
--           is pointed at the chosen block for that one call and put back, and the game aims,
--           checks reach, sight and pickaxe power, sends Hit and breaks the block on screen;
--   pets    your equipped pets mine blocks near you by themselves (the server's PetMine), which is
--           most of the speed;
--   sell    standing on the Sell pad makes the game sell the bag;
--   shop    Purchase("BuyTool" | "BuyStorage", name) and DailyBuy(id) on their pads;
--   leave   the Exit pad.
-- Without getconnections the hub sends Hit itself, and broken blocks are not removed on screen
-- until the mine is redrawn.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local Options = Ui.Options
local RS = Env.ReplicatedStorage
local UserInputService = game:GetService("UserInputService")
local tab = Ui.Tabs.Minigames

local function load(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = RS
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local MiningWorld = load("Shared", "Minigames", "Mining", "MiningWorld")
local MiningConfig = load("Shared", "Minigames", "Mining", "MiningConfig")
local DailyShop = load("Shared", "Minigames", "Mining", "DailyShop")

local CRYSTAL_CAVE = Vector3.new(-53, 5445, -1992)
local SKIP_SECONDS = 60
local DAILY_ALL, DAILY_COINS, DAILY_GEMS, DAILY_OFF = "Coins and Gems packs", "Coins packs", "Gems packs", "Off"

local box = tab:AddGroupbox({ Side = "Right", Name = "Mine", IconName = "pickaxe" })
box:AddToggle("AutoMine", {
    Text = "Auto mine",
    Default = false,
    Tooltip = "Goes into the Crystal Cave mine and mines with you and your pets, selling whenever the bag is full. Auto hatch and other trips wait while it runs; turn it off to come back.",
})
Ui.automation("AutoMine", false)
box:AddToggle("MineUpgrades", {
    Text = "Buy pickaxes and bags",
    Default = true,
    Tooltip = "Spends mining coins on the next pickaxe or bag as soon as one is affordable. Better pickaxes break harder ore; the Copper Pickaxe is the only one that breaks Hardened Stone and the rare ores.",
})
box:AddDropdown("MineDaily", {
    Text = "Daily shop",
    Values = { DAILY_ALL, DAILY_COINS, DAILY_GEMS, DAILY_OFF },
    Default = DAILY_ALL,
    Tooltip = "Once every pickaxe and bag is bought, spare mining coins buy the daily shop's packs of real Coins or Gems (the Mining Legend title is never bought).",
})
local label = box:AddLabel("Auto mine is off.", true)

local session = { sold = 0, earned = 0, bought = {}, note = "" }

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function controller()
    local module = RS:FindFirstChild("Controllers") and RS.Controllers:FindFirstChild("Minigames")
    module = module and module:FindFirstChild("MiningController")
    if not module then
        return nil
    end
    local ok, result = Env.call(require, module)
    return ok and type(result) == "table" and result or nil
end

local function mineState()
    local mining = controller()
    if not mining or type(mining.GetState) ~= "function" then
        return nil
    end
    local ok, state = Env.call(mining.GetState, mining)
    return ok and type(state) == "table" and state or nil
end

local function inMine()
    return Env.LocalPlayer:GetAttribute("MiningActive") == true
end

local function teleport(cframe)
    local hrp = root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = cframe
    end
end

-- The game's own "tap a block" handler, once the mine's code has loaded.
local tapHandler
local function findTapHandler()
    if tapHandler or type(getconnections) ~= "function" then
        return tapHandler
    end
    local ok, connections = pcall(getconnections, UserInputService.TouchTapInWorld)
    for _, connection in ipairs(ok and type(connections) == "table" and connections or {}) do
        local fine, source = pcall(function()
            return connection.Function and debug.info(connection.Function, "s")
        end)
        if fine and type(source) == "string" and source:find("MiningController") then
            tapHandler = connection.Function
        end
    end
    Env.elevate()
    return tapHandler
end

local function enter()
    if inMine() then
        return true
    end
    Env.streamAround(CRYSTAL_CAVE, 10)
    teleport(CFrame.new(CRYSTAL_CAVE))
    local portal
    local deadline = os.clock() + 10
    repeat
        Life.wait(0.3)
        portal = MiningWorld and MiningWorld.Portal()
    until portal or not Life.alive or os.clock() > deadline
    if not portal then
        session.note = "Could not find the mine portal on Crystal Cave."
        return false
    end
    teleport(portal.CFrame)
    deadline = os.clock() + 20
    repeat
        Life.wait(0.3)
    until inMine() or not Life.alive or os.clock() > deadline
    Life.wait(1.5) -- the game's fade and the first blocks being drawn
    return inMine()
end

local function onPad(name, until_, seconds)
    local pad = MiningWorld and MiningWorld.Part(name)
    if not pad then
        return false
    end
    teleport(pad.CFrame + Vector3.new(0, 4, 0))
    local deadline = os.clock() + (seconds or 6)
    repeat
        Life.wait(0.3)
    until not until_ or until_() or not Life.alive or os.clock() > deadline
    return true
end

local function ask(name, ...)
    local ok, result = Env.invoke("MiningService", name, ...)
    if ok and type(result) == "table" and not result.Error then
        return result
    end
    return nil, tostring(ok and type(result) == "table" and result.Error or result)
end

-- The next pickaxe or bag above what you use, if you can pay for it now.
local function nextUpgrade(state)
    if not MiningConfig then
        return nil
    end
    local balance = tonumber(state.Balance) or 0
    local best
    for _, kind in ipairs({ "Tool", "Bag" }) do
        local list = kind == "Tool" and MiningConfig.Tools or MiningConfig.Bags
        local current = tonumber(kind == "Tool" and state.Tool or state.Backpack) or 1
        local item = list[current + 1]
        if item and (not best or item.Price < best.price) then
            best = { kind = kind, name = item.Name, price = item.Price, affordable = item.Price <= balance }
        end
    end
    return best
end

-- The dearest daily-shop pack of the chosen kind you can pay for, or nil.
local dailySkip = {} -- id -> day it sold out for you
local function nextDaily(state)
    local pick = Options.MineDaily.Value
    if not DailyShop or pick == DAILY_OFF then
        return nil
    end
    local day = DailyShop.Day(os.time())
    local offers = {}
    local ok, rotating = Env.call(DailyShop.Rotating, day)
    for _, offer in ipairs(ok and type(rotating) == "table" and rotating or {}) do
        offers[#offers + 1] = offer
    end
    for _, offer in ipairs(DailyShop.PermanentOffers()) do
        offers[#offers + 1] = offer
    end
    local balance = tonumber(state.Balance) or 0
    local best
    for _, offer in ipairs(offers) do
        local kindOk = (offer.Kind == "Clicks" and pick ~= DAILY_GEMS) or (offer.Kind == "Gems" and pick ~= DAILY_COINS)
        if kindOk and dailySkip[offer.Id] ~= day and (tonumber(offer.Price) or math.huge) <= balance
            and (not best or offer.Price > best.Price) then
            best = offer
        end
    end
    return best, day
end

local function spend()
    local state = mineState()
    if not state then
        return
    end
    if Ui.on("MineUpgrades") then
        local upgrade = nextUpgrade(state)
        while upgrade and upgrade.affordable and Life.alive do
            onPad("Shop")
            local result, why = ask("Purchase", upgrade.kind == "Tool" and "BuyTool" or "BuyStorage", upgrade.name)
            if not result then
                session.note = string.format("Could not buy the %s: %s.", upgrade.name, why)
                return
            end
            session.bought[#session.bought + 1] = upgrade.name
            session.note = "Bought the " .. upgrade.name .. "."
            Life.wait(0.6)
            state = mineState() or state
            upgrade = nextUpgrade(state)
        end
        if upgrade then
            return -- saving for the next upgrade before anything else
        end
    end
    local offer, day = nextDaily(state)
    while offer and Life.alive do
        onPad("Daily")
        local result, why = ask("DailyBuy", offer.Id)
        if not result then
            dailySkip[offer.Id] = day
            session.note = string.format("Daily shop: %s (%s).", offer.Name, why)
        else
            session.bought[#session.bought + 1] = offer.Name
            session.note = "Daily shop: bought a " .. offer.Name .. "."
        end
        Life.wait(0.6)
        state = mineState() or state
        offer, day = nextDaily(state)
    end
end

local function sellAndSpend()
    local before = mineState()
    local balance = before and tonumber(before.Balance) or 0
    onPad("Sell", function()
        local state = mineState()
        return state and (tonumber(state.Count) or 0) == 0
    end, 8)
    local after = mineState()
    if after and (tonumber(after.Count) or 0) == 0 then
        session.sold += 1
        session.earned += math.max(0, (tonumber(after.Balance) or 0) - balance)
    end
    spend()
end

-- Mining ---------------------------------------------------------------------------------------

local skipped = {} -- key -> skip until (os.clock)

-- Ores at least this valuable are taken before plain rock wherever they are uncovered: Copper (20)
-- and up. Dirt is worth 1, Stone 3, Coal 10; gems 250-650 (BlockStats).
local ORE_VALUE = 20

-- The block to mine: one the game has drawn (drawn blocks are the exposed ones near you) that your
-- pickaxe can break and that has open space above it. The most valuable uncovered ore first, then
-- plain rock top layers first (the mine is Dirt for 3 layers, Stone down to 20, Hardened Stone
-- below), then the nearest.
local function chooseTarget(state, marker)
    local folder = workspace:FindFirstChild("LocalMiningBlocks")
    if not folder or not MiningConfig then
        return nil
    end
    local tool = MiningConfig.Tools[tonumber(state.Tool) or 1]
    local power = tool and tool.Power or 1
    local drawn = {}
    for _, block in ipairs(folder:GetChildren()) do
        if block.Name:match("^%d+:%d+:%d+$") then
            drawn[block.Name] = block
        end
    end
    local hrp = root()
    local here = hrp and hrp.Position or marker.Position
    local now = os.clock()
    local best
    local function better(candidate)
        if not best then
            return true
        end
        local oreA, oreB = candidate.value >= ORE_VALUE, best.value >= ORE_VALUE
        if oreA ~= oreB then
            return oreA
        end
        if oreA and candidate.value ~= best.value then
            return candidate.value > best.value
        end
        if not oreA and candidate.y ~= best.y then
            return candidate.y < best.y
        end
        return candidate.distance < best.distance
    end
    for key, block in pairs(drawn) do
        if (skipped[key] or 0) <= now then
            local x, y, z = key:match("^(%d+):(%d+):(%d+)$")
            x, y, z = tonumber(x), tonumber(y), tonumber(z)
            local above = y > 0 and MiningConfig.Key(x, y - 1, z) or nil
            if not (above and drawn[above]) then
                local ok, _, stats = pcall(MiningConfig.Ore, state.Seed, x, y, z)
                if ok and stats and (tonumber(stats.pickaxeRequirement) or 0) <= power then
                    local position = MiningConfig.Position(marker, x, y, z)
                    local candidate = { key = key, x = x, y = y, z = z, position = position, block = block,
                        health = tonumber(stats.health) or 10, value = tonumber(stats.value) or 0,
                        distance = (position - here).Magnitude }
                    if better(candidate) then
                        best = candidate
                    end
                end
            end
        end
    end
    return best, tool
end

local function stillThere(target)
    return target.block.Parent ~= nil and target.block.Name == target.key
end

-- One swing at the target through the game's own input, or the remote when that is out of reach.
local function swing(state, target)
    local handler = findTapHandler()
    if handler then
        local camera = workspace.CurrentCamera
        local hrp = root()
        if not (camera and hrp) then
            return
        end
        local saved = camera.CFrame
        camera.CFrame = CFrame.lookAt(hrp.Position + Vector3.new(0, 1.5, 0), target.position)
        local center = camera.ViewportSize / 2
        pcall(handler, Vector2.new(center.X, center.Y), false)
        camera.CFrame = saved
        Env.elevate()
    else
        Env.invoke("MiningService", "Hit", state.Id, target.x, target.y, target.z)
    end
end

local function mineOne(state, marker)
    local target, tool = chooseTarget(state, marker)
    if not target then
        return false
    end
    local stand = target.position + Vector3.new(0, MiningConfig.BlockSize + 1, 0)
    local hrp = root()
    if hrp and (hrp.Position - stand).Magnitude > 3 then
        teleport(CFrame.new(stand))
        Life.wait(0.2)
    end
    local damage = tool and tool.Damage or 1
    local interval = tool and tool.Interval or 0.45
    local swings = math.ceil(target.health / math.max(damage, 1)) + 4
    for _ = 1, swings do
        if not (Life.alive and Ui.on("AutoMine") and stillThere(target)) then
            break
        end
        local current = mineState()
        if current and (tonumber(current.Count) or 0) >= (tonumber(current.Capacity) or math.huge) then
            return true -- the bag filled up mid-block
        end
        swing(state, target)
        Life.wait(interval + 0.03)
    end
    if stillThere(target) then
        skipped[target.key] = os.clock() + SKIP_SECONDS
    end
    return true
end

local busy = false
local function run()
    busy = true
    Ui.travelling = "mining"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(function()
        Ui.status = "Mining"
        if not enter() then
            session.note = session.note ~= "" and session.note or "Could not get into the mine."
            return
        end
        local idle = 0
        while Life.alive and Ui.on("AutoMine") do
            if not inMine() and not enter() then
                break
            end
            local state = mineState()
            local marker = MiningWorld and MiningWorld.Marker()
            if not (state and marker and state.Seed) then
                Life.wait(0.5)
            elseif (tonumber(state.Count) or 0) >= (tonumber(state.Capacity) or math.huge) then
                sellAndSpend()
            elseif not mineOne(state, marker) then
                -- nothing drawn to mine right here: let the pets work and look again
                idle += 1
                Life.wait(1)
                if idle % 10 == 0 then
                    table.clear(skipped)
                end
            else
                idle = 0
            end
        end
        if inMine() then
            if (tonumber((mineState() or {}).Count) or 0) > 0 then
                sellAndSpend()
            end
            onPad("Exit", function()
                return not inMine()
            end, 12)
        end
    end)
    Env.elevate()
    if not ok then
        Life.errors["mining:run"] = tostring(err)
        session.note = "Mining error: " .. tostring(err)
    end
    Life.wait(1)
    if home then
        teleport(home)
    end
    if Ui.status == "Mining" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

local function short(n)
    for _, unit in ipairs({ { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= unit[1] then
            return string.format("%.1f%s", n / unit[1], unit[2])
        end
    end
    return tostring(math.floor(n))
end

Life.loop("mining:auto", 1, function()
    local data = Env.data()
    local mining = data and type(data.Mining) == "table" and data.Mining or {}
    local state = inMine() and mineState() or nil
    local lines = {}
    local tools = MiningConfig and MiningConfig.Tools or {}
    local bags = MiningConfig and MiningConfig.Bags or {}
    local tool = tools[tonumber(mining.Tool) or 1]
    local bag = bags[tonumber(mining.Backpack) or 1]
    lines[1] = string.format("%s, %s. %s mining coins.", tool and tool.Name or "?", bag and bag.Name or "?",
        short(tonumber(mining.Coins) or 0))
    if state then
        local total = tonumber(state.Total) or 10000
        local mined = tonumber(state.Mined) or 0
        lines[#lines + 1] = string.format("Mine %.1f%% cleared (%d / %d), bag %d/%d.", mined / total * 100, mined, total,
            tonumber(state.Count) or 0, tonumber(state.Capacity) or 0)
    end
    if session.sold > 0 then
        lines[#lines + 1] = string.format("%d sales this session for %s mining coins.", session.sold, short(session.earned))
    end
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    if not Ui.on("AutoMine") then
        label:SetText("Off. " .. table.concat(lines, "\n"))
        return
    end
    label:SetText(table.concat(lines, "\n"))
    if not busy and not Ui.travelling and not Ui.hatchMoving and MiningWorld and MiningConfig then
        Life.spawn("mining:run", run)
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
end)

return {}
end

Modules["features/fishing"] = function(use)
-- Minigames tab: fishing (FishingService; Shared.Minigames.Fishing.FishingConfig and FishingSim).
--
-- Fishing is idle. Each spot has 3 rod stands (4 with the FourthRod mastery unlock). A rod is cast
-- with up to 10 bait and catches one thing every bait interval (a Worm every 15 minutes, a Firefly
-- every 20 with x3 luck) until its bait runs out. Small catches go to the Fish Bowl when it is
-- unlocked; everything else stays hooked on the line (at most 3) until it is reeled in at the dock.
--
-- Catches depend on water zones and bait quality:
--
--  * Zones. Lucky (x1.5 luck), Golden (x2.5) and Rare (x4) patches drift across the pond on a
--    seeded, deterministic path (FishingSim.ZonePosition), and the Rare one surfaces for 30
--    seconds in 40% of 90-second windows (ZoneShown). The server stamps a rod with the luck of the
--    zone its cast landed in, at the time the cast says it was thrown (aim.T, up to 3s old), and
--    the rod keeps it for its whole load. Every cast goes to the centre of the best zone that
--    is up; casting at the computed Golden centre lands ZoneLuck = 2.5.
--  * Server Seeds (v4046+). Seeds are generated and kept server-side, so predictions and lucky
--    recasting are retired. The hub automates full-cycle idle fishing: optimal zone aiming,
--    auto-reeling, bowl clearing, and bait restocking.
--
-- Everything needs you at the dock (FishingConfig.Range, 26 studs), so the hub makes short trips:
-- reel, recast, top up bait, and back. The rods keep fishing while you are away.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local Options = Ui.Options
local tab = Ui.Tabs.Minigames

local function shared(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = Env.ReplicatedStorage.Shared
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local Config = shared("Minigames", "Fishing", "FishingConfig")
local Sim = shared("Minigames", "Fishing", "FishingSim")

-- Measured in the game. The Heaven Falls dock is always loaded; the Haunted Pond streams with
-- Halloween Island, so it is looked for around the island centre the first time it is wanted.
local DOCKS = { HeavenFalls = Vector3.new(36.9, 15348.6, -2059.8) }
local HALLOWEEN_ISLAND = Vector3.new(-1680.8, -515.7, -2317.3)

local spotIds, spotByName = {}, {}
local baitNames, baitByName = {}, {}
if Config then
    for id, spot in pairs(Config.Spots) do
        spotIds[#spotIds + 1] = spot.Name
        spotByName[spot.Name] = id
    end
    table.sort(spotIds, function(a, b)
        return (spotByName[a] == "HeavenFalls") and spotByName[b] ~= "HeavenFalls" or (spotByName[b] ~= "HeavenFalls" and a < b)
    end)
    for _, key in ipairs(Config.BaitOrder) do
        local bait = Config.Baits[key]
        baitNames[#baitNames + 1] = bait.Name
        baitByName[bait.Name] = key
    end
end
-- Shrimp and up: worth every one the Fisherman stocks. Eyeballs cost Candy Corn and are left alone.
local LUCK_BAIT = 1.5

-- UI -------------------------------------------------------------------------------------------

local box = tab:AddGroupbox({ Side = "Right", Name = "Fishing", IconName = "fish" })
box:AddToggle("AutoFish", {
    Text = "Auto fish",
    Default = false,
    Tooltip = "Keeps every rod in the water at the chosen spot, reels in what they hook and loads fresh bait. Short trips to the dock; the rods keep fishing while you are away.",
})
Ui.automation("AutoFish", false)
box:AddDropdown("FishSpot", {
    Text = "Spot",
    Values = #spotIds > 0 and spotIds or { "Heaven Falls" },
    Default = spotIds[1] or "Heaven Falls",
    Tooltip = "Heaven Falls needs Heaven unlocked. The Haunted Pond is on Halloween Island during the event.",
})
box:AddDropdown("FishBaits", {
    Text = "Use these baits",
    Values = baitNames,
    Multi = true,
    Default = baitNames,
    Tooltip = "The luckiest bait you hold goes on first: Rainbow Squid x12, Golden Worm x6, Firefly x3, Shrimp and Eyeball x1.5, then Cricket and Worm.",
})
box:AddToggle("FishWaitRare", {
    Text = "Wait for the Rare zone",
    Default = true,
    Tooltip = "With a luck bait (Firefly and better), waits up to a minute for the Rare zone (x4 luck) to surface instead of taking Golden (x2.5). The zone's timing is computed, not guessed.",
})
box:AddToggle("FishBuyBait", {
    Text = "Buy bait with Gems",
    Default = true,
    Tooltip = "Buys the Fisherman's offers for the baits you use while you hold fewer than 10, and takes his free gift once.",
})
box:AddToggle("FishStockUp", {
    Text = "Stock up on luck bait",
    Default = true,
    Tooltip = "Buys every Shrimp, Firefly, Golden Worm and Rainbow Squid the Fisherman has, whatever you already hold: they are what makes secrets likely, and his 3 rotating offers change every 3 hours. Paid in Gems; Eyeballs (Candy Corn) are never bought.",
})
local label = box:AddLabel("Off.", true)

-- Reading the game ------------------------------------------------------------------------------

local session = { trips = 0, casts = 0, reeled = 0, bought = 0, rings = 0, secrets = 0, note = "" }

local function fishingData(data)
    return type(data) == "table" and type(data.Fishing) == "table" and data.Fishing or {}
end

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function serverNow()
    return workspace:GetServerTimeNow()
end

local function spotModel(spotId)
    local ok, model = Env.call(Config.FindSpotModel, spotId)
    return ok and model or nil
end

local function pondOf(model)
    local pond = model and model:FindFirstChild("Pond")
    if not (pond and pond:IsA("BasePart")) then
        return nil
    end
    return { X = pond.Position.X, Z = pond.Position.Z, RadiusX = pond.Size.X / 2, RadiusZ = pond.Size.Z / 2, Y = pond.Position.Y }
end

local function rodLimit(data)
    local ok, limit = Env.call(Config.RodLimit, data)
    return ok and tonumber(limit) or Config.MaxRods
end

-- The baits to use, with how many you hold. Sorted by bait luck (luckiest first).
local function baitQueue(data, spotId)
    local owned = fishingData(data).Bait or {}
    local picks = Options.FishBaits.Value or {}
    local out = {}
    for _, key in ipairs(Config.BaitOrder) do
        local bait = Config.Baits[key]
        if picks[bait.Name] and (tonumber(owned[key]) or 0) > 0 then
            out[#out + 1] = { key = key, bait = bait, owned = tonumber(owned[key]) }
        end
    end
    table.sort(out, function(a, b)
        if a.bait.Luck ~= b.bait.Luck then
            return a.bait.Luck > b.bait.Luck
        end
        return a.bait.Order < b.bait.Order
    end)
    return out
end

-- The best zone that is up right now, and where to aim for its centre.
local function bestAim(spotId, pond, castPart, now)
    local spot = Config.Spots[spotId]
    local best
    for index, key in ipairs(spot.Zones or {}) do
        local zone = Config.Zones[key]
        local shown = Sim.ZoneShown(spot, index, now)
        if zone and shown and shown > 0 then
            local x, z = Sim.ZonePosition(spot, index, pond, now)
            local reach = Vector3.new(x - castPart.Position.X, 0, z - castPart.Position.Z).Magnitude
            local _, landed = Sim.ZoneAt(spot, pond, x, z, now)
            if landed == key and reach <= Config.Cast.MaxDistance and (not best or zone.Luck > best.luck) then
                best = { x = x, z = z, key = key, luck = zone.Luck }
            end
        end
    end
    if best then
        return best
    end
    -- No zone in reach: the pond's centre still catches, at plain luck.
    return { x = pond.X, z = pond.Z, key = nil, luck = 1 }
end

-- Seconds until the Rare zone next surfaces (0 when it is up), or nil beyond `horizon`.
local function rareIn(spotId, now, horizon)
    local spot = Config.Spots[spotId]
    local index = table.find(spot.Zones or {}, "Rare")
    if not index then
        return nil
    end
    for wait = 0, horizon do
        if (Sim.ZoneShown(spot, index, now + wait)) > 0.3 then
            return wait
        end
    end
    return nil
end

-- Server calls ------------------------------------------------------------------------------------

-- The server takes about one Cast and one Remove a second (measured: ten casts a second apart all
-- went through; at 0.75s or 0.5s every other one was refused). Recasting faster than that does not
-- recast faster, it just loses rods to refusals, so both are paced and a refusal is waited out.
local PACED = { Cast = 1.05, Remove = 1.05 }
local lastCall = {}

local function ask(name, ...)
    local why
    for _ = 1, 4 do
        local gap = PACED[name] and PACED[name] - (os.clock() - (lastCall[name] or 0)) or 0
        if gap > 0 then
            Life.wait(gap)
        end
        lastCall[name] = os.clock()
        local ok, result = Env.invoke("FishingService", name, ...)
        if ok and type(result) == "table" and result.Success then
            return result
        end
        why = ok and type(result) == "table" and (result.Error or result.Reason) or result
        if why ~= "RateLimited" then
            break
        end
        Life.wait(1.1)
    end
    session.lastRefusal = string.format("%s refused: %s", name, tostring(why))
    return nil, tostring(why)
end

local function cast(rodId, spotId, pond, castPart, bait, load)
    -- The aim and its T are taken before ask's pacing wait. The server judges the zone at T (it
    -- accepts a T up to 3 seconds old), so the cast lands where the zone was when it was aimed.
    local aim = bestAim(spotId, pond, castPart, serverNow())
    local result, why = ask("Cast", rodId, bait, load, { X = aim.x, Z = aim.z, T = serverNow() })
    if result then
        session.casts += 1
    end
    return result, why
end

-- Rings: a better tier always wins; within a tier, more fishing luck.
local function ringScore(ring)
    if type(ring) ~= "table" then
        return -1
    end
    local def = Config.Rings[ring.Name]
    local score = (def and def.Order or 0) * 1000
    for _, boost in ipairs(type(ring.Boosts) == "table" and ring.Boosts or {}) do
        if type(boost) == "table" and boost.Type == "FishingLuck" then
            score += (tonumber(boost.Value) or 0) * 100
        end
    end
    return score
end

local function settleRing()
    local fishing = fishingData(Env.data())
    if type(fishing.PendingRing) ~= "table" then
        return
    end
    local choice = ringScore(fishing.PendingRing) > ringScore(fishing.Ring) and "replace" or "keep"
    local result = ask("ClaimRing", choice)
    if result then
        session.rings += 1
        session.note = choice == "replace" and ("Equipped " .. tostring(fishing.PendingRing.Name) .. ".") or "Kept your fishing ring."
    end
end

-- The Fisherman's offers this 3-hour window (FishingSim.ShopOffers: the permanent Worms plus 3
-- rotating ones) and how many of each are left, from what this window's Shop.Bought records.
local function shopNow(data)
    local now = serverNow()
    local shop = fishingData(data).Shop or {}
    -- ShopOffers takes the window number, not the time: given the time it rolled a different
    -- rotation on every call, and the server refused those as "NotOffered".
    local okWindow, window = Env.call(Sim.ShopWindow, now)
    window = okWindow and tonumber(window) or math.floor(now / (Config.Shop.WindowSeconds or 10800))
    local okOffers, offers = Env.call(Sim.ShopOffers, window, nil)
    local bought = shop.Window == window and type(shop.Bought) == "table" and shop.Bought or {}
    local out = {}
    for _, offer in ipairs(okOffers and type(offers) == "table" and offers or {}) do
        if type(offer) == "table" and type(offer.Id) == "string" then
            out[#out + 1] = { offer = offer, window = window,
                left = math.max(0, (tonumber(offer.Stock) or 1) - (tonumber(bought[offer.Id]) or 0)) }
        end
    end
    return out
end

-- Every luck bait with Stock up on (what makes secrets likely, and rarely in stock); otherwise a bait
-- you use and hold fewer than 10 of. Eyeballs cost Candy Corn and are never bought.
local function wantOffer(data, offer)
    local bait = Config.Baits[offer.Bait]
    if not bait or offer.Currency == "CandyCorn" then
        return false
    end
    if Ui.on("FishStockUp") and bait.Luck >= LUCK_BAIT then
        return true
    end
    local owned = tonumber((fishingData(data).Bait or {})[offer.Bait]) or 0
    return (Options.FishBaits.Value or {})[bait.Name] == true and owned < 10
end

local refusedWindow = {} -- window:offer -> refused once this window (not offered, not affordable)
local function shopToBuy(data)
    if not Ui.on("FishBuyBait") then
        return {}
    end
    local list = {}
    for _, entry in ipairs(shopNow(data)) do
        if entry.left > 0 and not refusedWindow[entry.window .. ":" .. entry.offer.Id] and wantOffer(data, entry.offer) then
            list[#list + 1] = entry
        end
    end
    -- The luckiest first, in case the Gems run out partway.
    table.sort(list, function(a, b)
        return Config.Baits[a.offer.Bait].Luck > Config.Baits[b.offer.Bait].Luck
    end)
    return list
end

local function buyBait(data)
    for _, entry in ipairs(shopToBuy(data)) do
        for _ = 1, entry.left do
            local result, why = ask("Buy", entry.offer.Id)
            if not result then
                refusedWindow[entry.window .. ":" .. entry.offer.Id] = true
                if why ~= "NotOffered" and why ~= "SoldOut" then
                    session.note = "Bait purchase refused: " .. why .. "."
                end
                break
            end
            session.bought += 1
            Life.wait(0.3)
        end
    end
end

local giftTried = false
-- A refusal that will not go away by itself (a locked spot, a pond this server does not have)
-- would otherwise send you to the dock every 15 seconds.
local backoffUntil = 0
local function backoff(note)
    session.note = note
    backoffUntil = os.clock() + 120
end

-- The trip ---------------------------------------------------------------------------------------

local function dockOf(spotId)
    local model = spotModel(spotId)
    if model and model:FindFirstChild("RootPart") then
        return model, model.RootPart.Position
    end
    local known = DOCKS[spotId]
    Env.streamAround(known or HALLOWEEN_ISLAND, 4)
    model = spotModel(spotId)
    if model and model:FindFirstChild("RootPart") then
        DOCKS[spotId] = model.RootPart.Position
        return model, model.RootPart.Position
    end
    return nil, known
end

local function tend(spotId)
    local model, dock = dockOf(spotId)
    if not dock then
        backoff(Config.Spots[spotId].Name .. " is not in this server; trying again in 2 minutes.")
        return
    end
    local here = root()
    if here then
        here.AssemblyLinearVelocity = Vector3.zero
        here.CFrame = CFrame.new(dock + Vector3.new(0, 3, 0))
    end
    Life.wait(0.7)
    model = model or spotModel(spotId)
    local pond, castPart = pondOf(model), model and model:FindFirstChild("Cast")
    if not (pond and castPart) then
        backoff("The dock did not load; trying again in 2 minutes.")
        return
    end

    if Ui.on("FishBuyBait") and not giftTried then
        giftTried = true
        if ask("ClaimGift") then
            session.note = "Took the Fisherman's gift."
        end
    end
    settleRing()

    local spot = Config.Spots[spotId]
    local limit = math.min(spot.Slots, rodLimit(Env.data()))
    -- How many of each secret pet you have caught, to tell you when a reel brings one in.
    local function secretCounts()
        local caught = fishingData(Env.data()).Caught or {}
        local counts = {}
        for key, catch in pairs(Config.Catches) do
            if catch.Kind == "Pet" then
                counts[key] = tonumber(caught[key]) or 0
            end
        end
        return counts
    end
    local before = secretCounts()
    -- Reel first: a rod with 3 fish on the line stops catching.
    for slot = 1, spot.Slots do
        local rodId = Config.RodId(spotId, slot)
        for _ = 1, 6 do
            local rod = (fishingData(Env.data()).Rods or {})[rodId]
            if not (rod and type(rod.Hooked) == "table" and #rod.Hooked > 0) then
                break
            end
            local result, why = ask("Reel", rodId)
            if not result then
                if why == "ClaimRingFirst" then
                    settleRing()
                else
                    break
                end
            else
                session.reeled += 1
                if type(result.Ring) == "table" then
                    Life.wait(0.3)
                    settleRing()
                end
            end
            Life.wait(0.25)
        end
    end
    Life.wait(0.3)
    for key, count in pairs(secretCounts()) do
        local gained = count - (before[key] or 0)
        if gained > 0 then
            local name = Config.Catches[key].Name
            session.secrets = (session.secrets or 0) + gained
            session.note = string.format("Caught %s! (%d this session)", name, session.secrets)
            Ui.notify("Fishing", string.format("You caught %s%s!", gained > 1 and (gained .. "x ") or "", name), 15)
        end
    end
    local data = Env.data()
    local fishing = fishingData(data)
    local okBowl, bowlSize = Env.call(Config.BowlSize, data)
    local okCount, bowlCount = Env.call(Sim.BowlCount, fishing.Bowl or {})
    if okBowl and (bowlSize or 0) > 0 and okCount and (bowlCount or 0) > 0 then
        ask("Collect")
    end
    buyBait(Env.data())

    local function rodNow(rodId)
        return (fishingData(Env.data()).Rods or {})[rodId]
    end
    -- Replication of the rod can trail the server's answer, so wait for the change to arrive
    -- before reading it: a rod gone after Remove, a new seed after Cast.
    local function settled(rodId, test)
        local deadline = os.clock() + 1.5
        while os.clock() < deadline and not test(rodNow(rodId)) do
            Life.wait(0.05)
        end
        return test(rodNow(rodId))
    end
    local function pickUp(rodId)
        local result, why = ask("Remove", rodId)
        if result then
            settled(rodId, function(rod)
                return rod == nil
            end)
        end
        return result, why
    end
    local function castAndSettle(rodId, bait, load, oldCast)
        local result, why = cast(rodId, spotId, pond, castPart, bait, load)
        if result then
            settled(rodId, function(rod)
                if not rod then
                    return false
                end
                if oldCast ~= nil then
                    return rod.Cast ~= oldCast
                end
                return true
            end)
        end
        return result, why
    end

    for slot = 1, limit do
        if not (Life.alive and Ui.on("AutoFish")) then
            break
        end
        local rodId = Config.RodId(spotId, slot)
        local rod = rodNow(rodId)
        local spent = rod ~= nil and (tonumber(rod.Left) or 0) <= 0
        local hooked = rod ~= nil and type(rod.Hooked) == "table" and #rod.Hooked > 0
        if not rod or spent then
            -- Picked up first, so its bait is back in the bag when the next bait is chosen.
            if rod then
                local removed, whyRemove = pickUp(rodId)
                if not removed then
                    session.stopped = string.format("%s: could not pick it up (%s).", rodId, tostring(whyRemove))
                    break
                end
            end
            local pick = baitQueue(Env.data(), spotId)[1]
            if not pick then
                session.note = "Out of bait" .. (Ui.on("FishBuyBait") and "; the Fisherman's offers are bought as they come." or ".")
                break
            end
            local load = math.min(pick.owned, Config.Cast.Load)
            -- A luck bait is worth waiting a little for x4 instead of x2.5:
            -- the Rare zone is up 30s in ~225s, and casting into Rare finds better catches.
            if Ui.on("FishWaitRare") and pick.bait.Luck >= 3 then
                local wait = rareIn(spotId, serverNow(), 60)
                if wait and wait > 0 then
                    session.note = string.format("Waiting %ds for the Rare zone.", wait)
                    Life.wait(wait + 0.5)
                end
            end
            local result, why = castAndSettle(rodId, pick.key, load, nil)
            if not result then
                session.note = "Cast refused: " .. why .. "."
                if why == "SpotLocked" or why == "TooFar" or why == "RodLimit" or why == "EventOver" then
                    backoff("Cast refused: " .. why .. "; trying again in 2 minutes.")
                    break
                end
            end
            Life.wait(0.3)
        end
    end
end

local busy = false
local function trip(spotId)
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "fishing"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    Ui.status = "Fishing at " .. Config.Spots[spotId].Name
    local ok, err = pcall(tend, spotId)
    Env.elevate()
    if not ok then
        Life.errors["fishing:trip"] = tostring(err)
    end
    session.trips += 1
    if home then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    if Ui.status == "Fishing at " .. Config.Spots[spotId].Name then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

-- Whether the spot needs a visit: an empty or spent rod, something hooked, a ring waiting, or
-- bait to buy from the Fisherman.
local function needsVisit(data, spotId)
    local fishing = fishingData(data)
    if type(fishing.PendingRing) == "table" then
        return true
    end
    -- Luck bait on offer goes when it is offered: the window changes every 3 hours.
    if #shopToBuy(data) > 0 then
        return true
    end
    local spot = Config.Spots[spotId]
    local limit = math.min(spot.Slots, rodLimit(data))
    local haveBait = #baitQueue(data, spotId) > 0
    for slot = 1, spot.Slots do
        local rod = (fishing.Rods or {})[Config.RodId(spotId, slot)]
        if rod and type(rod.Hooked) == "table" and #rod.Hooked > 0 then
            return true
        end
        if slot <= limit and haveBait and (not rod or (tonumber(rod.Left) or 0) <= 0) then
            return true
        end
    end
    return false
end

-- The loop -----------------------------------------------------------------------------------------

local nextTrip = 0
Life.loop("fishing:auto", 2, function()
    if not (Config and Sim) then
        label:SetText("Fishing is not available in this version of the game.")
        return
    end
    local data = Env.data()
    if not data then
        return
    end
    local spotId = spotByName[Options.FishSpot.Value] or "HeavenFalls"
    local fishing = fishingData(data)
    local now = serverNow()
    local lines = {}
    for slot = 1, Config.Spots[spotId].Slots do
        local rodId = Config.RodId(spotId, slot)
        local rod = (fishing.Rods or {})[rodId]
        if not rod then
            lines[#lines + 1] = string.format("Rod %d: in its stand", slot)
        else
            local bait = Config.Baits[rod.Bait]
            local hooked = type(rod.Hooked) == "table" and #rod.Hooked or 0
            local nextIn = (tonumber(rod.Next) or now) - now
            lines[#lines + 1] = string.format("Rod %d: %s x%d%s, %s", slot, bait and bait.Name or tostring(rod.Bait),
                tonumber(rod.Left) or 0, rod.Zone and (" in " .. rod.Zone) or "",
                hooked > 0 and string.format("%d hooked", hooked)
                    or (tonumber(rod.Left) or 0) > 0 and string.format("next in %d:%02d", math.max(0, nextIn) // 60, math.max(0, nextIn) % 60)
                    or "out of bait")
        end
    end
    local queue = baitQueue(data, spotId)
    local owned = {}
    for _, item in ipairs(queue) do
        owned[#owned + 1] = string.format("%s %d", item.bait.Name, item.owned)
    end
    lines[#lines + 1] = "Bait: " .. (#owned > 0 and table.concat(owned, ", ") or "none selected in stock")
    local offers = {}
    for _, entry in ipairs(shopNow(data)) do
        local bait = Config.Baits[entry.offer.Bait]
        if bait and entry.offer.Currency ~= "CandyCorn" then
            offers[#offers + 1] = string.format("%s x%d%s", bait.Name, tonumber(entry.offer.Amount) or 1,
                entry.left > 0 and string.format(" (%d left)", entry.left) or " (bought)")
        end
    end
    if #offers > 0 then
        local window = Config.Shop.WindowSeconds or 10800
        local endsIn = window - math.floor(now % window)
        lines[#lines + 1] = string.format("Fisherman: %s; new offers in %dh%02dm", table.concat(offers, ", "), endsIn // 3600, (endsIn % 3600) // 60)
    end
    if (session.secrets or 0) > 0 then
        lines[#lines + 1] = string.format("Secret pets caught this session: %d", session.secrets)
    end
    if session.stopped then
        lines[#lines + 1] = session.stopped
    end
    if session.lastRefusal then
        lines[#lines + 1] = "Last refusal: " .. session.lastRefusal
    end
    lines[#lines + 1] = string.format("This session: %d casts, %d reeled, %d bait offers bought.",
        session.casts, session.reeled, session.bought)
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    label:SetText((Ui.on("AutoFish") and "" or "Off. ") .. table.concat(lines, "\n"))

    if not Ui.on("AutoFish") or busy or os.clock() < nextTrip or os.clock() < backoffUntil then
        return
    end
    if needsVisit(data, spotId) then
        nextTrip = os.clock() + 15
        Life.spawn("fishing:trip", trip, spotId)
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
    end
    table.clear(refusedWindow)
end)

return {}
end

Modules["features/halloween"] = function(use)
-- Halloween tab: the Halloween event's Hallow Boss (Shared.Game.HallowBossConfig).
--
-- The Hallow Lord fights on the Halloween island at the top of every hour (IntervalSeconds 3600):
-- a 2-minute warning, then up to 7 minutes of fight. Damage comes from your ordinary taps while you
-- stand on the boss platform (the part tagged BossPlatform; ZoneSlack/ZoneBelow/ZoneAbove around
-- it), 1 per tap and 5 per critical. Everyone who deals at least MinDamage (25) gets CandyCorn
-- (250, plus 0.5 per damage; the top three 600/450/350), a potion roll and a 1 in 5,000 shot at
-- the Hallow Lord pet, better for the top three.
--
-- HallowBossService.RP.State is a Comm property ({ Phase = Idle | Warning | Fight | Defeated,
-- StartsAt, EndsAt, Health, ... }); firing it asks for the current value. Attack { Targets,
-- Radius, Delay } is a bomb volley: a bomb knocks you back off the platform if it lands within
-- Radius (9) of you, so the hub steps to the clear part of the platform when one is coming.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local CollectionService = game:GetService("CollectionService")
local Options = Ui.Options
local tab = Ui.Tabs.Halloween

local Config
do
    local ok, module = Env.call(function()
        return require(Env.ReplicatedStorage.Shared.Game.HallowBossConfig)
    end)
    Config = ok and type(module) == "table" and module or nil
end

-- workspace.HalloweenIsland.BossPlatform (84 x 82 studs), measured in the game: going straight there
-- streams the platform in at once.
local ISLAND_CENTER = Vector3.new(-1680.8, -515.7, -2317.3)
local PLATFORM_TAG = Config and Config.PlatformTag or "BossPlatform"

local box = tab:AddGroupbox({ Side = "Left", Name = "Hallow Boss", IconName = "skull" })
box:AddToggle("AutoHallowBoss", {
    Text = "Fight the Hallow Boss",
    Default = false,
    Tooltip = "At the top of every hour, goes to the Halloween island, stands on the boss platform and taps the Hallow Lord down, stepping aside from its bombs. CandyCorn, a potion and a 1 in 5,000 shot at the Hallow Lord pet.",
})
Ui.automation("AutoHallowBoss", false)
local label = box:AddLabel("Off.", true)

local state = {}
local session = { fights = 0, candy = 0, note = "" }
local bombs = {} -- { position, radius, at }

Life.spawn("hallow:watch", function()
    local service = Env.ReplicatedStorage.RemoteServices:FindFirstChild("HallowBossService")
    if not service then
        return
    end
    local property = service:FindFirstChild("RP") and service.RP:FindFirstChild("State")
    if property then
        Life.connect(property.OnClientEvent, function(value)
            if type(value) == "table" then
                state = value
            end
        end)
        pcall(function()
            property:FireServer()
        end)
        Env.elevate()
    end
    local events = service:FindFirstChild("RE")
    local attack = events and events:FindFirstChild("Attack")
    if attack then
        Life.connect(attack.OnClientEvent, function(volley)
            if type(volley) ~= "table" or type(volley.Targets) ~= "table" then
                return
            end
            local radius = tonumber(volley.Radius) or (Config and Config.BombRadius) or 9
            local landsAt = os.clock() + (tonumber(volley.Delay) or (Config and Config.BombDelay) or 1.6)
            for _, target in ipairs(volley.Targets) do
                if typeof(target) == "Vector3" then
                    bombs[#bombs + 1] = { position = target, radius = radius, at = landsAt }
                end
            end
        end)
    end
    local reward = events and events:FindFirstChild("Reward")
    if reward then
        Life.connect(reward.OnClientEvent, function(result)
            if type(result) == "table" then
                session.candy += tonumber(result.Candy or result.CandyCorn or result.Amount) or 0
                session.note = "Reward: " .. tostring(result.Candy or result.CandyCorn or result.Amount or "?") .. " CandyCorn."
            end
        end)
    end
end)

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function platform()
    for _, part in ipairs(CollectionService:GetTagged(PLATFORM_TAG)) do
        if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
            return part
        end
    end
    return nil
end

-- A standing spot on the platform as far as possible from the bombs about to land.
local function safeSpot(part)
    local top = part.CFrame:PointToWorldSpace(Vector3.new(0, part.Size.Y * 0.5, 0))
    local half = math.min(part.Size.X, part.Size.Z) * 0.5 - 3
    local now = os.clock()
    for index = #bombs, 1, -1 do
        if bombs[index].at < now - 0.5 then
            table.remove(bombs, index)
        end
    end
    local best, bestScore
    for ring = 0, 2 do
        local steps = ring == 0 and 1 or 8
        for step = 0, steps - 1 do
            local angle = step / steps * math.pi * 2
            local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (half * ring / 2)
            local spot = top + offset
            local score = math.huge
            for _, bomb in ipairs(bombs) do
                local flat = Vector3.new(spot.X - bomb.position.X, 0, spot.Z - bomb.position.Z).Magnitude
                score = math.min(score, flat - bomb.radius)
            end
            if not best or score > bestScore then
                best, bestScore = spot, score
            end
        end
    end
    return best + Vector3.new(0, 3, 0)
end

local busy = false
local function fight()
    if busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    busy = true
    Ui.travelling = "hallowboss"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(function()
        Ui.status = "Fighting the Hallow Boss"
        Env.streamAround(ISLAND_CENTER, 4)
        local here = root()
        if here then
            here.AssemblyLinearVelocity = Vector3.zero
            here.CFrame = CFrame.new(ISLAND_CENTER + Vector3.new(0, 20, 0))
        end
        local part
        local deadline = os.clock() + 10
        repeat
            Life.wait(0.3)
            part = platform()
        until part or not Life.alive or os.clock() > deadline
        if not part then
            session.note = "Could not find the boss platform."
            return
        end
        session.fights += 1
        Ui.tapDemand = true
        local limit = os.clock() + ((Config and Config.FightSeconds) or 420) + 150
        while Life.alive and Ui.on("AutoHallowBoss") and os.clock() < limit do
            local phase = state.Phase
            if phase ~= "Warning" and phase ~= "Fight" then
                break
            end
            local spot = safeSpot(part)
            local current = root()
            if current and (current.Position - spot).Magnitude > 2.5 then
                current.AssemblyLinearVelocity = Vector3.zero
                current.CFrame = CFrame.new(spot)
            end
            Life.wait(0.2)
        end
        Ui.tapDemand = false
    end)
    Ui.tapDemand = false
    Env.elevate()
    if not ok then
        Life.errors["hallow:fight"] = tostring(err)
        session.note = "Error: " .. tostring(err)
    end
    if home then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    if Ui.status == "Fighting the Hallow Boss" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

local nextTry = 0
Life.loop("hallow:auto", 1, function()
    local now = workspace:GetServerTimeNow()
    local phase = state.Phase or "?"
    local text
    if phase == "Fight" then
        text = string.format("Fight on: %s / %s health.", tostring(state.Health), tostring(state.MaxHealth))
    elseif phase == "Warning" then
        text = string.format("Spawning in %ds.", math.max(0, math.floor((tonumber(state.StartsAt) or now) - now)))
    else
        local starts = tonumber(state.StartsAt) or (Config and Config.NextStart(now)) or now
        local wait = math.max(0, starts - now)
        text = string.format("Next fight in %d:%02d.", wait // 60, math.floor(wait % 60))
    end
    local lines = { text, string.format("This session: %d fights, %d CandyCorn.", session.fights, session.candy) }
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    label:SetText((Ui.on("AutoHallowBoss") and "" or "Off. ") .. table.concat(lines, "\n"))
    if Ui.on("AutoHallowBoss") and (phase == "Warning" or phase == "Fight") and not busy and os.clock() >= nextTry then
        nextTry = os.clock() + 20
        Life.spawn("hallow:fight", fight)
    end
end)

-- Trick or treat, the Candy Witch's dailies and the CandyCorn shop -----------------------------
--
-- Trick or treat (Shared.Game.TrickOrTreatConfig): 11 houses on the Halloween island, each with a
-- pad (a "TrickOrTreat" model with a HouseId attribute and a Zone part) in front of its door.
-- TrickOrTreatService.Knock(houseId) from inside the Zone pays 20-40 CandyCorn (x1.5 on a trick)
-- and 80% of the time a potion; each house is ready again 30 minutes later (Data.TrickOrTreat
-- [house] = ready-at), and all 11 fill the bag for another 150 CandyCorn and a Bag of Treats.
-- Candy Witch (Shared.Quests.HalloweenDailyConfig): HalloweenDailyService.Accept() hands out 3 jobs
-- a day (100-150 CandyCorn each, 300 more for all three); they are ordinary quests after that.
-- Shop (Shared.Items.HalloweenShopConfig): HalloweenShopService.Purchase { Id }, from anywhere.
-- Limits are for the whole event (SoldOut), except Daily items, which restock each day (SoldOutToday).

local TrickConfig, DailyConfig, ShopConfig
do
    local function load(path)
        local ok, module = Env.call(function()
            local node = Env.ReplicatedStorage
            for part in path:gmatch("[^%.]+") do
                node = node:FindFirstChild(part)
            end
            return node and require(node)
        end)
        return ok and type(module) == "table" and module or nil
    end
    TrickConfig = load("Shared.Game.TrickOrTreatConfig")
    DailyConfig = load("Shared.Quests.HalloweenDailyConfig")
    ShopConfig = load("Shared.Items.HalloweenShopConfig")
end

-- Measured in the game; going there streams the house and its pad in.
local HOUSES = {
    House01 = Vector3.new(-1689.4, -497.4, -1723.4), House02 = Vector3.new(-1735.6, -492.9, -1791.8),
    House03 = Vector3.new(-1628.7, -497.6, -1801.2), House04 = Vector3.new(-1734.4, -497.6, -1875.2),
    House05 = Vector3.new(-1627.4, -492.9, -1874.3), House06 = Vector3.new(-1764.9, -492.9, -1931.0),
    House07 = Vector3.new(-1596.6, -497.7, -1933.5), House08 = Vector3.new(-1818.5, -498.0, -1955.0),
    House09 = Vector3.new(-1823.8, -509.5, -2047.3), House10 = Vector3.new(-1761.8, -497.5, -2107.5),
    House11 = Vector3.new(-1595.7, -492.9, -2100.4),
}
local WITCH = Vector3.new(-1649.8, -506.4, -2029.9)

-- The shop, in the shop's own order; nothing is picked by default (CandyCorn is precious).
local SHOP_ITEMS, SHOP_LABELS, SHOP_ID = {}, {}, {}
for _, item in ipairs(ShopConfig and (ShopConfig.Items or ShopConfig.List or ShopConfig) or {}) do
    if type(item) == "table" and type(item.Id) == "string" then
        local name = (item.DisplayName or item.Name or item.Id) .. string.format(" (%d)", tonumber(item.Price) or 0)
        SHOP_ITEMS[#SHOP_ITEMS + 1] = item
        SHOP_LABELS[#SHOP_LABELS + 1] = name
        SHOP_ID[name] = item
    end
end

local candyBox = tab:AddGroupbox({ Side = "Right", Name = "Candy", IconName = "candy" })
candyBox:AddToggle("AutoTrickOrTreat", {
    Text = "Trick or treat",
    Default = false,
    Tooltip = "Knocks at all 11 houses on the Halloween island whenever they are ready (every 30 minutes): 20-40 CandyCorn and usually a potion each, plus 150 CandyCorn for a full bag.",
})
Ui.automation("AutoTrickOrTreat", false)
candyBox:AddToggle("AutoCandyWitch", {
    Text = "Take the Candy Witch's jobs",
    Default = false,
    Tooltip = "Accepts her 3 daily jobs once a day (100-150 CandyCorn each, 300 more for all three). Finished jobs are claimed like other quests (Auto claim finished quests).",
})
Ui.automation("AutoCandyWitch", false)
candyBox:AddToggle("AutoCandyShop", {
    Text = "Buy from the CandyCorn shop",
    Default = false,
    Tooltip = "Buys your picks as a set you use together: always the one you hold the fewest of next, saving up for it instead of spending on a cheaper pick, until you hold the stock below of each. Sold-out and once-a-day items are skipped.",
})
Ui.automation("AutoCandyShop", true)
candyBox:AddDropdown("CandyShopPicks", {
    Text = "Buy these",
    Values = #SHOP_LABELS > 0 and SHOP_LABELS or { "?" },
    Multi = true,
    Default = {},
})
candyBox:AddSlider("CandyShopStock", {
    Text = "Keep in stock",
    Default = 2,
    Min = 1,
    Max = 10,
    Rounding = 0,
    Tooltip = "Stops buying a pick while you hold this many of it unused (a 3-pack of potions counts as one), so CandyCorn is not sunk into a pile you never use.",
})
local candyLabel = candyBox:AddLabel("", true)

local candy = { knocks = 0, earned = 0, bought = 0, note = "", shop = "" }

local function readyHouses(data)
    local list = {}
    local now = workspace:GetServerTimeNow()
    local record = type(data.TrickOrTreat) == "table" and data.TrickOrTreat or {}
    for _, id in ipairs(TrickConfig and TrickConfig.Houses or {}) do
        if HOUSES[id] and (tonumber(record[id]) or 0) <= now then
            list[#list + 1] = id
        end
    end
    return list
end

local function padZone(id)
    local folder = workspace:FindFirstChild(TrickConfig and TrickConfig.Folder or "HalloweenIsland")
    for _, model in ipairs(folder and folder:GetChildren() or {}) do
        if model.Name == (TrickConfig and TrickConfig.PadName or "TrickOrTreat") and model:GetAttribute("HouseId") == id then
            local zone = model:FindFirstChild(TrickConfig and TrickConfig.ZoneName or "Zone")
            if zone and zone:IsA("BasePart") then
                return zone
            end
        end
    end
    return nil
end

-- Keeps you on a spot every frame while `fn` runs (the server checks you are in the pad's zone).
local function holdAt(position, fn)
    local hold = game:GetService("RunService").Heartbeat:Connect(function()
        local hrp = root()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(position)
        end
    end)
    local ok, result = pcall(fn)
    hold:Disconnect()
    Env.elevate()
    return ok and result
end

local function trickOrTreat()
    for _, id in ipairs(readyHouses(Env.data() or {})) do
        if not (Life.alive and Ui.on("AutoTrickOrTreat")) then
            break
        end
        Env.streamAround(HOUSES[id], 3)
        local hrp = root()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(HOUSES[id] + Vector3.new(0, 6, 0))
        end
        local zone
        local deadline = os.clock() + 4
        repeat
            Life.wait(0.2)
            zone = padZone(id)
        until zone or not Life.alive or os.clock() > deadline
        if zone then
            local result = holdAt(zone.Position + Vector3.new(0, 2.5, 0), function()
                Life.wait(0.8)
                local ok, answer = Env.invoke("TrickOrTreatService", "Knock", id)
                return ok and answer
            end)
            if type(result) == "table" and result.Success == true then
                candy.knocks += 1
                candy.earned += tonumber(result.Candy) or 0
                candy.note = string.format("%s: %s CandyCorn%s.", id, tostring(result.Candy or 0),
                    result.Potion and (" and a " .. tostring(result.Potion)) or "")
            elseif type(result) == "table" then
                candy.note = id .. ": " .. tostring(result.Reason or "refused")
            end
        end
    end
end

local function candyWitch()
    Env.streamAround(WITCH, 3)
    holdAt(WITCH + Vector3.new(0, 3, 4), function()
        Life.wait(0.8)
        local ok, result = Env.invoke("HalloweenDailyService", "Accept")
        if ok and type(result) == "table" and result.Success == true then
            candy.note = result.Already and "The Candy Witch's jobs are already taken today." or "Took the Candy Witch's jobs."
        else
            candy.note = "Candy Witch: " .. tostring(type(result) == "table" and result.Reason or result)
        end
    end)
end

-- The picks are a set you use together (an Octo Incubator with a Luck Potion II and a Totem of
-- Luck), so the next buy is always the pick you hold the fewest of, and the hub saves up for it
-- rather than spending on a cheaper one. Buying "whatever is affordable, in shop order" sank 4,000
-- CandyCorn into four incubators with nothing to go with them.

-- The shop's own rules (HalloweenShopConfig.IsListed / GetRemaining, which the shop screen uses):
-- GetRemaining is nil when unlimited and 0 when sold out (for good, or today for daily items).
local function shopRule(name, data, item, fallback)
    local rule = ShopConfig and ShopConfig[name]
    if type(rule) ~= "function" then
        return fallback
    end
    local ok, value = Env.call(rule, data, item)
    if ok then
        return value
    end
    return fallback
end

-- Unused copies you hold, in purchases: potions come 3 to a purchase, so 4 of them count as 1.33.
-- Pets have no stock to count; their limit of 1 is what stops them.
local function heldPurchases(data, item)
    local owned
    if item.Kind == "Boost" then
        owned = type(data.Boosts) == "table" and data.Boosts[item.Name]
    elseif item.Kind == "Item" then
        local items = type(data.Items) == "table" and data.Items.Owned
        owned = type(items) == "table" and items[item.Name]
    end
    return (tonumber(owned) or 0) / math.max(tonumber(item.Amount) or 1, 1)
end

local shopRestUntil = 0
local function buyFromShop(data)
    if os.clock() < shopRestUntil then
        return
    end
    local picks = Options.CandyShopPicks.Value or {}
    if ShopConfig and type(ShopConfig.IsOpen) == "function" then
        local ok, open = Env.call(ShopConfig.IsOpen)
        if ok and open == false then
            candy.shop = "Shop: the Halloween shop is closed."
            return
        end
    end
    local keep = tonumber(Options.CandyShopStock.Value) or 2
    local want, wantHeld, wantIndex
    for index, item in ipairs(SHOP_ITEMS) do
        if picks[SHOP_LABELS[index]] and shopRule("IsListed", data, item, true) ~= false
            and shopRule("GetRemaining", data, item, nil) ~= 0 then
            local held = heldPurchases(data, item)
            -- Strictly fewer, so ties go to the shop's order.
            if held < keep and (not want or held < wantHeld) then
                want, wantHeld, wantIndex = item, held, index
            end
        end
    end
    if not want then
        candy.shop = next(picks) and "Shop: stocked up on everything picked." or ""
        return
    end
    local balance = tonumber(type(data.Currencies) == "table" and data.Currencies.CandyCorn) or 0
    local price = tonumber(want.Price) or math.huge
    if balance < price then
        candy.shop = string.format("Shop: saving for %s, %d of %d.", SHOP_LABELS[wantIndex], balance, price)
        return
    end
    local ok, result = Env.invoke("HalloweenShopService", "Purchase", { Id = want.Id })
    -- The replica can land after the answer; counting stock again too soon would buy the same pick twice.
    shopRestUntil = os.clock() + 3
    if ok and type(result) == "table" and result.Success == true then
        candy.bought += 1
        candy.shop = "Shop: bought " .. SHOP_LABELS[wantIndex] .. "."
    else
        candy.shop = string.format("Shop: %s refused (%s).", SHOP_LABELS[wantIndex],
            tostring(type(result) == "table" and result.Reason or result))
        shopRestUntil = os.clock() + 30
    end
end

local candyBusy = false
local function candyTrip(job)
    if candyBusy or busy or Ui.hatchMoving or Ui.travelling then
        return
    end
    candyBusy = true
    Ui.travelling = "halloween"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    local ok, err = pcall(job)
    Env.elevate()
    if not ok then
        Life.errors["halloween:trip"] = tostring(err)
        candy.note = "Error: " .. tostring(err)
    end
    if home then
        local back = root()
        if back then
            back.AssemblyLinearVelocity = Vector3.zero
            back.CFrame = home
        end
    end
    Ui.travelling = false
    candyBusy = false
end

local nextKnock, nextWitch, lastWitchDay = 0, 0, nil
Life.loop("halloween:candy", 2, function()
    local data = Env.data()
    if not data then
        return
    end
    local balance = tonumber(type(data.Currencies) == "table" and data.Currencies.CandyCorn) or 0
    local ready = readyHouses(data)
    local dailies = type(data.HalloweenDailies) == "table" and data.HalloweenDailies or {}
    local today = DailyConfig and DailyConfig.Today(os.time()) or math.floor(os.time() / 86400)
    local lines = {
        string.format("%d CandyCorn. %d of 11 houses ready.", balance, #ready),
        string.format("This session: %d knocks for %d CandyCorn, %d bought.", candy.knocks, candy.earned, candy.bought),
    }
    if candy.note ~= "" then
        lines[#lines + 1] = candy.note
    end
    if Ui.on("AutoCandyShop") and candy.shop ~= "" then
        lines[#lines + 1] = candy.shop
    end
    candyLabel:SetText(table.concat(lines, "\n"))
    if Ui.on("AutoCandyShop") then
        buyFromShop(data)
    end
    if candyBusy or busy or Ui.travelling or Ui.hatchMoving then
        return
    end
    if Ui.on("AutoTrickOrTreat") and #ready > 0 and os.clock() >= nextKnock then
        nextKnock = os.clock() + 60
        Life.spawn("halloween:knock", candyTrip, trickOrTreat)
    elseif Ui.on("AutoCandyWitch") and dailies.Day ~= today and lastWitchDay ~= today and os.clock() >= nextWitch then
        nextWitch = os.clock() + 300
        lastWitchDay = today
        Life.spawn("halloween:witch", candyTrip, candyWitch)
    end
end)

Life.onCleanup(function()
    Ui.tapDemand = false
    if busy or candyBusy then
        Ui.travelling = false
    end
end)

return {}
end

Modules["features/dungeon"] = function(use)
-- Halloween tab: Count Greg's Mansion, the Halloween dungeon (HalloweenDungeonService;
-- Shared.Game.HalloweenDungeon.Config and ModifierConfig). Mapped from a full clear on 2026-10-24.
--
-- Unlocking takes one word with Count Greg: his intro dialogue fires Talk, the server answers
-- Unlocked and sets Data.HalloweenDungeon.Unlocked. A run starts when you stand in the circle by his
-- mansion (10-second countdown, up to 4 players); the server moves you into a dungeon cell and the
-- rooms (Workspace.HalloweenDungeonRuns.Run_N.RoomK) follow each other along -Z: a foyer, 4 to 6
-- middle rooms (bat ambush, piñata, treasure vault, mimic hunt, the Elder Bat), then Count Greg.
-- Once every 30 minutes from the last start.
--
--  * Damage is ordinary taps (TapService), 1 per tap, applied to what you have targeted:
--    SetTarget(mobId) for a mob, SetTarget(nil) for Count Greg. Untargeted taps do nothing, which
--    is why the game's own client needs you to tap on a bat. The hub keeps auto tap running for the
--    whole run (Ui.tapDemand) and always targets the weakest mob, so bats die before they bite.
--  * A cleared room opens its exit door (DoorOpened) but the next room only starts once you are 26
--    studs into it. The hub steps through as the door finishes opening.
--  * Each cleared room pays a chest by itself (about the same in coins as everything you held
--    before the run, and Candy Corn), then offers a choice of 3 blessings. Count Greg pays several
--    times that. One test run took a 5.8e21 coin balance to 3.3e23.
--  * Vault and mimic chests are instances tagged HalloweenDungeonChest (ChestId, Hp, Opened, Gem)
--    targeted with ChestTarget; from 125 studs nothing happens, so the hub stands next to them.
--    Those rooms also clear on their timer if the chests are left alone.

local Env = use("core/env")
local Life = use("shared/life")
local Ui = use("core/ui")

local Options = Ui.Options
local tab = Ui.Tabs.Halloween

local function shared(...)
    local path = { ... }
    local ok, module = Env.call(function()
        local node = Env.ReplicatedStorage.Shared
        for _, part in ipairs(path) do
            node = node:FindFirstChild(part)
        end
        return node and require(node)
    end)
    return ok and type(module) == "table" and module or nil
end

local Config = shared("Game", "HalloweenDungeon", "Config")
local Modifiers = shared("Game", "HalloweenDungeon", "ModifierConfig")

-- Measured in the game.
local GREG = Vector3.new(-1490.0, -498.7, -2040.0)
local CIRCLE = Vector3.new(-1433.3, -496.8, -2014.5)

-- Loot first (a run is easy: the test clear took no deaths), then what makes rooms go faster,
-- then survival. "Candy Corn" focus puts Candy Sack ahead of Lucky Loot.
local BLESSINGS = { "LuckyLoot", "CandySack", "BatBane", "ChestCracker", "GregSlayer", "BusyPaws", "PetFury",
    "VampireBite", "IronCape", "ThickFur" }
local CHEST_ROOMS = { TreasureVault = true, MimicHunt = true }
local SAFETY_SECONDS = 15 * 60

-- UI -------------------------------------------------------------------------------------------

local box = tab:AddGroupbox({ Side = "Left", Name = "Count Greg's Mansion", IconName = "castle" })
box:AddToggle("AutoDungeon", {
    Text = "Auto dungeon",
    Default = false,
    Tooltip = "Unlocks the mansion if needed, then runs it every 30 minutes: targets every bat, piñata and the Elder Bat, steps into each next room as its door opens, picks blessings and taps Count Greg down. Each room pays a chest of coins and Candy Corn.",
})
Ui.automation("AutoDungeon", false)
box:AddDropdown("DungeonFocus", {
    Text = "Blessing focus",
    Values = { "Coins", "Candy Corn" },
    Default = "Coins",
    Tooltip = "Lucky Loot (+20% coins) or Candy Sack (+25% Candy Corn) first. After that: Bat Bane, Chest Cracker, Greg Slayer, Busy Paws, Pet Fury, then the survival ones.",
})
box:AddToggle("DungeonChests", {
    Text = "Break vault chests",
    Default = true,
    Tooltip = "In treasure vault and mimic rooms, stands next to each chest (gem chests first) and taps it open once the bats are down. Those rooms clear on their timer either way.",
})
local panel = Ui.panel(box, 7)

-- Run state, fed by the dungeon's events ---------------------------------------------------------

local session = { runs = 0, coins = 0, candy = 0, contracts = nil, note = "" }
local run = nil -- { mobs, boss, room, objective, doors, ended, coins, candy, rooms, started } while a run is live

local function newRun()
    return { mobs = {}, boss = nil, room = nil, objective = nil, doors = {}, ended = nil, started = nil,
        coins = 0, candy = 0, rooms = 0, unlocked = false }
end

local function remoteOf(name)
    local ok, remote = pcall(Env.remote, "HalloweenDungeonService", name)
    Env.elevate()
    return ok and remote or nil
end

local function send(name, ...)
    local remote = remoteOf(name)
    if remote then
        local args = table.pack(...)
        pcall(function()
            remote:FireServer(table.unpack(args, 1, args.n))
        end)
        Env.elevate()
    end
end

local function on(name, handler)
    local remote = remoteOf(name)
    if remote then
        Life.connect(remote.OnClientEvent, function(...)
            if run then
                handler(...)
            end
        end, "dungeon:" .. name)
    end
end

on("RunStarted", function()
    run.started = run.started or os.clock()
    task.delay(0.5, send, "SkipIntro")
end)
on("RoomStarted", function(payload)
    if type(payload) == "table" then
        run.room, run.objective = payload.RoomName, payload.Objective
        run.rooms = math.max(run.rooms, tonumber(payload.RoomIndex) or 0)
        table.clear(run.mobs)
    end
end)
on("MobState", function(payload)
    if type(payload) == "table" and payload.Id ~= nil and (tonumber(payload.Hp) or 1) > 0 then
        local mob = run.mobs[payload.Id] or {}
        mob.hp, mob.kind = tonumber(payload.Hp) or mob.hp or 1, payload.Kind or mob.kind
        run.mobs[payload.Id] = mob
    end
end)
on("MobHit", function(payload)
    if type(payload) == "table" and run.mobs[payload.Id] then
        run.mobs[payload.Id].hp = tonumber(payload.Hp) or run.mobs[payload.Id].hp
        run.mobs[payload.Id].hitAt = os.clock()
    end
end)
on("MobRemoved", function(payload)
    if type(payload) == "table" then
        run.mobs[payload.Id] = nil
    end
end)
on("BossState", function(payload)
    if type(payload) == "table" then
        run.boss = { hp = tonumber(payload.Hp) or 0, phase = payload.Phase }
    end
end)
on("BossCutscene", function(payload)
    if type(payload) == "table" and payload.CanSkip then
        task.delay(0.3, send, "BossSkip")
    end
end)
on("DoorOpened", function(payload)
    if type(payload) == "table" and not payload.Entrance and type(payload.RoomName) == "string" then
        table.insert(run.doors, { room = payload.RoomName, at = os.clock() + (tonumber(payload.Seconds) or 2.5) + 0.4 })
    end
end)
on("BlessingOffer", function(payload)
    if type(payload) ~= "table" or type(payload.Choices) ~= "table" then
        return
    end
    local order = table.clone(BLESSINGS)
    if Options.DungeonFocus.Value == "Candy Corn" then
        order[1], order[2] = "CandySack", "LuckyLoot"
    end
    local pick, rank = payload.Choices[1], math.huge
    for _, choice in ipairs(payload.Choices) do
        local at = table.find(order, choice) or (#order + 1)
        if at < rank then
            pick, rank = choice, at
        end
    end
    task.delay(0.4, send, "BlessingPick", payload.OfferId, pick)
end)
on("RelicFound", function(payload)
    local id = type(payload) == "table" and (payload.Id or payload.RelicId) or payload
    task.delay(0.3, send, "CollectRelic", id)
end)
on("RewardCards", function(payload)
    for _, card in ipairs(type(payload) == "table" and type(payload.Cards) == "table" and payload.Cards or {}) do
        if type(card) == "table" and card.Kind == "Coins" then
            run.coins += tonumber(card.Amount) or 0
        elseif type(card) == "table" and card.Kind == "Candy" then
            run.candy += tonumber(card.Amount) or 0
        end
    end
end)
on("Results", function(payload)
    run.ended = run.ended or os.clock()
    if type(payload) == "table" and type(payload.Contracts) == "table" then
        session.contracts = payload.Contracts
    end
end)
on("RunEnded", function()
    run.ended = run.ended or os.clock()
end)
on("Unlocked", function()
    run.unlocked = true
end)

-- Helpers --------------------------------------------------------------------------------------------

local function root()
    local character = Env.LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function moveTo(position, facing)
    local hrp = root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = facing and CFrame.lookAt(position, facing) or CFrame.new(position)
    end
end

local function dungeonData(data)
    return type(data) == "table" and type(data.HalloweenDungeon) == "table" and data.HalloweenDungeon or {}
end

local function readyIn(data)
    local ok, at = Env.call(Config.ReadyAt, data)
    return math.max(0, (ok and tonumber(at) or 0) - workspace:GetServerTimeNow())
end

local function currentRun()
    local folder = workspace:FindFirstChild("HalloweenDungeonRuns")
    if not folder then
        return nil
    end
    -- Every run has the same room names (Room1, Room2, ...), so a name says nothing about whose run
    -- it is. Runs sit in cells 3000 studs apart along X (Config.CellPitchX) and the server puts us
    -- in ours, so ours is the run nearest us in X. Runs too far away to stream in have no parts and
    -- are skipped.
    local hrp = root()
    local best, bestGap
    for _, model in ipairs(folder:GetChildren()) do
        local part = hrp and model:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local gap = math.abs(part.Position.X - hrp.Position.X)
            if not best or gap < bestGap then
                best, bestGap = model, gap
            end
        end
    end
    return best or folder:GetChildren()[1]
end

local function stepThrough(roomName)
    local model = currentRun()
    local room = model and model:FindFirstChild(roomName)
    local gate = room and room:FindFirstChild("ExitGate")
    local snap = gate and gate:FindFirstChild("ExitSnap")
    if snap then
        -- The next room starts 26 studs in (Config.NextRoomTriggerDepth); 32 clears it.
        local depth = (Config.NextRoomTriggerDepth or 26) + 6
        local at = snap.Position + Vector3.new(0, 3, -depth)
        moveTo(at, at + Vector3.new(0, 0, -1))
    end
end

local function weakestMob()
    local best, bestHp
    for id, mob in pairs(run.mobs) do
        local hp = tonumber(mob.hp) or 1
        if hp > 0 and (not best or hp < bestHp) then
            best, bestHp = id, hp
        end
    end
    return best
end

local function bestChest()
    local model = currentRun()
    local hrp = root()
    if not (model and hrp) then
        return nil
    end
    local best, bestScore
    for _, chest in ipairs(game:GetService("CollectionService"):GetTagged("HalloweenDungeonChest")) do
        if chest:IsDescendantOf(model) and chest:GetAttribute("Opened") ~= true and (tonumber(chest:GetAttribute("Hp")) or 0) > 0 then
            local position = chest:IsA("Model") and chest:GetPivot().Position or chest.Position
            local score = (position - hrp.Position).Magnitude
                - (chest:GetAttribute("Gem") == true and 400 or 0) - (chest:GetAttribute("Size") == "Big" and 150 or 0)
            if not best or score < bestScore then
                best, bestScore = chest, score
            end
        end
    end
    return best
end

-- The run -------------------------------------------------------------------------------------------

local function unlock()
    Env.streamAround(GREG, 4)
    local mansion = workspace:FindFirstChild("HalloweenIsland") and workspace.HalloweenIsland:FindFirstChild("CountGregMansion")
    local greg = mansion and mansion:FindFirstChild("CountGreg")
    local pivot = greg and greg:GetPivot()
    if pivot then
        local at = pivot.Position + pivot.LookVector * 6 + Vector3.new(0, 2, 0)
        moveTo(at, pivot.Position)
    else
        moveTo(GREG + Vector3.new(8, 4, 0))
    end
    Life.wait(0.8)
    send("Talk")
    local deadline = os.clock() + 5
    while Life.alive and not run.unlocked and os.clock() < deadline do
        Life.wait(0.1)
    end
    return run.unlocked or dungeonData(Env.data()).Unlocked == true
end

local function enterCircle()
    Env.streamAround(CIRCLE, 4)
    local spot = CIRCLE + Vector3.new(0, 3, 0)
    for _, circle in ipairs(game:GetService("CollectionService"):GetTagged(Config.CircleTag or "HalloweenDungeonCircle")) do
        if circle:IsDescendantOf(workspace) then
            local zone = circle:FindFirstChild(Config.ZoneName or "Zone", true)
            spot = (zone and zone:IsA("BasePart") and zone.Position or circle:GetPivot().Position) + Vector3.new(0, 3, 0)
        end
    end
    local deadline = os.clock() + (Config.CountdownSeconds or 10) + 35
    while Life.alive and Ui.on("AutoDungeon") and not run.started and os.clock() < deadline do
        local hrp = root()
        if hrp and (hrp.Position - spot).Magnitude > 5 then
            moveTo(spot)
        end
        Ui.status = "Waiting in Count Greg's circle"
        Life.wait(0.25)
    end
    return run.started ~= nil
end

local function fight()
    local target, targetAt, chestId, chestAt = "none", 0, nil, 0
    local hardStop = os.clock() + math.min(Config.MaxRunSeconds or 1800, SAFETY_SECONDS)
    while Life.alive and Ui.on("AutoDungeon") and os.clock() < hardStop do
        if run.ended and os.clock() - run.ended > 3 then
            break
        end
        Ui.tapDemand = true
        for index = #run.doors, 1, -1 do
            if os.clock() >= run.doors[index].at then
                stepThrough(table.remove(run.doors, index).room)
            end
        end
        local mob = weakestMob()
        local chest = mob == nil and Ui.on("DungeonChests") and CHEST_ROOMS[run.objective] and bestChest() or nil
        if mob ~= nil then
            -- A target that took no hit for 2s is resent: the server may have missed the first.
            local hitAt = run.mobs[mob] and run.mobs[mob].hitAt
            if mob ~= target or (os.clock() - targetAt > 2 and not (hitAt and os.clock() - hitAt < 2)) then
                target, targetAt = mob, os.clock()
                send("SetTarget", mob)
            end
            Ui.status = string.format("Dungeon: %s (%s)", tostring(run.objective or "room"), tostring(run.mobs[mob] and run.mobs[mob].kind or "mob"))
        elseif chest then
            local id = chest:GetAttribute("ChestId")
            local position = chest:IsA("Model") and chest:GetPivot().Position or chest.Position
            local hrp = root()
            if hrp and (hrp.Position - position).Magnitude > 9 then
                moveTo(position + Vector3.new(0, 3, 6), position)
            end
            if id ~= chestId or os.clock() - chestAt > 1.5 then
                chestId, chestAt = id, os.clock()
                send("ChestTarget", id)
            end
            Ui.status = "Dungeon: opening chests"
        elseif run.boss and run.boss.hp > 0 and run.boss.phase ~= "Defeat" then
            if target ~= false then
                target = false
                send("SetTarget", nil)
            end
            Ui.status = string.format("Dungeon: Count Greg %d hp", run.boss.hp)
        end
        Life.wait(0.15)
    end
    Ui.tapDemand = false
end

-- Dungeon cells sit far out at Y ~1000 from X -10000 on (Config.CellOriginX, CellPitchX, CellY).
local function inCell()
    local hrp = root()
    if not hrp then
        return false
    end
    local p = hrp.Position
    return p.X < (Config.CellOriginX or -10000) + 1500 and math.abs(p.Y - (Config.CellY or 1000)) < 600
end

local busy = false
local nextTry = 0
local function trip()
    if busy or Ui.hatchMoving or Ui.travelling or not Config then
        return
    end
    busy = true
    Ui.travelling = "dungeon"
    local settle = os.clock() + 6
    while Ui.hatchInFlight and os.clock() < settle do
        Life.wait(0.05)
    end
    local hrp = root()
    local home = hrp and hrp.CFrame
    run = newRun()
    local ok, err = pcall(function()
        if not (Config.IsUnlocked(Env.data()) or unlock()) then
            session.note = "Count Greg did not unlock the mansion; trying again in 2 minutes."
            nextTry = os.clock() + 120
            return
        end
        if not enterCircle() then
            session.note = "The run did not start; trying again in 2 minutes."
            nextTry = os.clock() + 120
            return
        end
        fight()
        session.runs += 1
        session.coins += run.coins
        session.candy += run.candy
        session.note = string.format("Last run: %d rooms, %.3g coins and %d Candy Corn in %ds.", run.rooms, run.coins,
            run.candy, math.floor(os.clock() - run.started))
        -- The server takes you out of the cell after its results screen. Going home first would
        -- only be undone by that move, so wait it out (bounded).
        local deadline = os.clock() + (Config.ResultsSeconds or 12) + 8
        while Life.alive and inCell() and os.clock() < deadline do
            Life.wait(0.25)
        end
    end)
    Env.elevate()
    if not ok then
        Life.errors["dungeon:trip"] = tostring(err)
    end
    Ui.tapDemand = false
    run = nil
    if home then
        moveTo(home.Position)
        local back = root()
        if back then
            back.CFrame = home
        end
    end
    if type(Ui.status) == "string" and Ui.status:find("^Dungeon") or Ui.status == "Waiting in Count Greg's circle" then
        Ui.status = "Idle"
    end
    Ui.travelling = false
    busy = false
end

-- The loop -----------------------------------------------------------------------------------------

Life.loop("dungeon:auto", 2, function()
    if not Config then
        panel.set({ "The mansion is not in this version of the game." })
        return
    end
    local data = Env.data()
    if not data then
        return
    end
    local stats = dungeonData(data)
    local wait = readyIn(data)
    local lines = {
        Config.IsUnlocked(data) and (wait > 0 and string.format("Next run in %d:%02d", wait // 60, wait % 60) or "Ready to run")
            or "Locked: the hub unlocks it by talking to Count Greg",
        string.format("Runs %d, clears %d, Count Greg defeated %d times", tonumber(stats.Runs) or 0, tonumber(stats.Clears) or 0,
            tonumber(stats.BossKills) or 0),
        string.format("This session: %d runs, %.3g coins, %d Candy Corn", session.runs, session.coins, session.candy),
    }
    if session.note ~= "" then
        lines[#lines + 1] = session.note
    end
    for _, contract in ipairs(session.contracts or {}) do
        if #lines >= 7 then
            break
        end
        if type(contract) == "table" and (tonumber(contract.Done) or 0) < (tonumber(contract.Total) or 0) then
            lines[#lines + 1] = string.format("Contract: %s %d/%d", tostring(contract.Text), contract.Done, contract.Total)
        end
    end
    panel.set(lines, Ui.on("AutoDungeon") and "Runs whenever the cooldown is over." or "Auto dungeon is off.")

    if Ui.on("AutoDungeon") and not busy and os.clock() >= nextTry and (not Config.IsUnlocked(data) or wait <= 0) then
        nextTry = math.max(nextTry, os.clock() + 30)
        Life.spawn("dungeon:trip", trip)
    end
end)

Life.onCleanup(function()
    if busy then
        Ui.travelling = false
        Ui.tapDemand = false
    end
    run = nil
end)

return {}
end

